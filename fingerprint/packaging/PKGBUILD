pkgname=libfprint-crfpmoc
pkgver=1.94.10
pkgrel=1
pkgdesc="Library for fingerprint readers with ChromeOS Match-on-Chip (MoC) driver support"
arch=('x86_64')
url="https://gitlab.freedesktop.org/3v1n0/libfprint"
license=('LGPL-2.1-or-later')
depends=('glib2' 'libgusb' 'pixman' 'libgudev' 'nss' 'systemd-libs')
makedepends=('meson' 'ninja' 'pkgconf' 'gobject-introspection' 'git')
provides=('libfprint' 'libfprint-2.so')
conflicts=('libfprint')
backup=('etc/udev/rules.d/60-cros-fp.rules')
source=("git+https://gitlab.freedesktop.org/3v1n0/libfprint.git#commit=56442591a5c302a906289f30988fb50fc3d82ed6"
        "crfpmoc-driver-overlay.tar.gz"
        "60-cros-fp.rules")
sha256sums=('SKIP'
            'f82a0195edf51211b0de6d8ab34aea988c780ec4eecd147dfcab61359be018dd'
            'SKIP')

prepare() {
    cd "${srcdir}/libfprint"
    tar -xzf "${srcdir}/crfpmoc-driver-overlay.tar.gz"
    # The overlay ships the audited driver including crfpmoc-proto.c, but
    # upstream meson.build only lists crfpmoc.c + crfpmoc-ec-transfer.c —
    # add it to the source list idempotently (mirrors install-fingerprint.sh).
    if [ -f "meson.build" ] && ! grep -q "drivers/crfpmoc/crfpmoc-proto.c" "meson.build"; then
        sed -i "s|'drivers/crfpmoc/crfpmoc-ec-transfer.c',|'drivers/crfpmoc/crfpmoc-ec-transfer.c',\n        'drivers/crfpmoc/crfpmoc-proto.c',|" "meson.build"
    fi
}

build() {
    cd "${srcdir}/libfprint"
    arch-meson build \
        -Ddrivers=default \
        -Dintrospection=true \
        -Dgtk-examples=false \
        -Ddoc=false
    ninja -C build
}

package() {
    cd "${srcdir}/libfprint"
    DESTDIR="${pkgdir}" ninja -C build install
    install -Dm644 "${srcdir}/60-cros-fp.rules" "${pkgdir}/usr/lib/udev/rules.d/60-cros-fp.rules"
}
