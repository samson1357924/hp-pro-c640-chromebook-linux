pkgname=libfprint-crfpmoc
pkgver=1.94.10
pkgrel=1
pkgdesc="Library for fingerprint readers with ChromeOS Match-on-Chip (MoC) driver support"
arch=('x86_64')
url="https://github.com/samson1357924/crfpmoc"
license=('LGPL-2.1-or-later')
depends=('glib2' 'libgusb' 'pixman' 'libgudev' 'nss' 'systemd-libs')
makedepends=('meson' 'ninja' 'pkgconf' 'gobject-introspection' 'git')
provides=('libfprint' 'libfprint-2.so')
conflicts=('libfprint')
backup=('etc/udev/rules.d/60-cros-fp.rules')
source=("git+https://github.com/samson1357924/crfpmoc.git#branch=master"
        "crfpmoc-driver-overlay.tar.gz"
        "60-cros-fp.rules")
sha256sums=('SKIP'
            'dd5064cbb3a6dce00f08827ab0d5491b6684967f25268f1c3888c5246c1c2c9f'
            'SKIP')

prepare() {
    cd "${srcdir}/crfpmoc"
    tar -xzf "${srcdir}/crfpmoc-driver-overlay.tar.gz"
}

build() {
    cd "${srcdir}/crfpmoc"
    arch-meson build \
        -Ddrivers=default \
        -Dintrospection=true \
        -Dgtk-examples=false \
        -Ddoc=false
    ninja -C build
}

package() {
    cd "${srcdir}/crfpmoc"
    DESTDIR="${pkgdir}" ninja -C build install
    install -Dm644 "${srcdir}/60-cros-fp.rules" "${pkgdir}/usr/lib/udev/rules.d/60-cros-fp.rules"
}
