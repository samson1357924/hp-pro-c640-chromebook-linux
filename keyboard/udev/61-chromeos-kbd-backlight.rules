# ChromeOS keyboard backlight LED - allow logged-in user to control brightness
# via sysfs without sudo. Complements the daemon that syncs kbd backlight with
# screen blank.
#
# NOTE: uaccess/MODE/GROUP only affect /dev device nodes. The LED brightness
# attribute is a plain sysfs file with no device node, so udev cannot chmod it
# through MODE=/GROUP= and an explicit RUN+= is required. Without this the
# daemon falls back to `sudo tee`, which a user service cannot answer for.
#
# Use %p (the device's sysfs devpath) instead of a hardcoded LED name/path so
# the rule follows the actual device instance. ACTION=="add|change" applies the
# RUN+= chmod/chgrp on add and change but not remove; matching change lets
# `udevadm trigger` apply the permissions immediately (its default action is
# change, not add).
SUBSYSTEM=="leds", KERNEL=="chromeos::kbd_backlight", ACTION=="add|change", TAG+="uaccess", GROUP="plugdev", MODE="0660", RUN+="/bin/chgrp plugdev /sys%p/brightness", RUN+="/bin/chmod 0660 /sys%p/brightness"
