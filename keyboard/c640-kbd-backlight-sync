#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 Samson <https://github.com/samson1357924>
# c640-kbd-backlight-sync - Keyboard backlight sync with screen blank
# Monitors org.gnome.ScreenSaver / org.freedesktop.ScreenSaver ActiveChanged
# (Wayland/X11) and org.freedesktop.login1 PrepareForSleep (S3) to turn off
# keyboard backlight when screen goes dark and restore it when screen lights up.
#
# Write chain (single-writer aware):
#   gsd-power Keyboard.Brightness (pct) -> UPower SetBrightness (raw) -> LED.
#   UPower's "external" signals are ignored by gsd-power, so writing UPower
#   alone leaves gsd-power's cache stale.  We therefore write the property
#   first and only fall back to direct UPower / sysfs / ectool writes.
#
# State is stored atomically in $XDG_RUNTIME_DIR/c640-kbd-backlight.state.
# A 5s sampler keeps the last user-visible brightness (0 = user explicitly
# switched it off) so a blank can be saved even when the LED was already
# turned off by firmware.
set -euo pipefail

# Optional sysfs overrides (mainly for testing / non-standard kernels).
SYSFS_BRIGHTNESS="${C640_KBD_SYSFS_BRIGHTNESS:-/sys/class/leds/chromeos::kbd_backlight/brightness}"
SYSFS_MAX="${C640_KBD_SYSFS_MAX:-/sys/class/leds/chromeos::kbd_backlight/max_brightness}"

# Secure per-user state directory
# Prefer XDG_RUNTIME_DIR, fallback to /run/user/<uid>, then secure tmp
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ]; then
    STATE_DIR="$XDG_RUNTIME_DIR"
elif [ -d "/run/user/$(id -u 2> /dev/null || echo 1000)" ] && [ -w "/run/user/$(id -u 2> /dev/null || echo 1000)" ]; then
    STATE_DIR="/run/user/$(id -u 2> /dev/null || echo 1000)"
else
    STATE_DIR="${TMPDIR:-/tmp}/c640-kbd-$(id -u 2> /dev/null || echo 1000)"
    mkdir -p "$STATE_DIR" 2> /dev/null || true
    chmod 700 "$STATE_DIR" 2> /dev/null || true
fi
STATE_FILE="$STATE_DIR/c640-kbd-backlight.state"
# Staging file used while a restore write is in flight.  STATE_FILE is renamed
# here just before the (potentially slow) write, so a blank arriving mid-write
# can still store its new value in STATE_FILE; the staged value is consumed
# only after the write has been verified.
RESTORE_PENDING_FILE="${C640_KBD_RESTORE_PENDING_FILE:-$STATE_DIR/c640-kbd-backlight.restore-pending}"
STATE_LOCK="$STATE_DIR/c640-kbd-backlight.state.lock"
LOCK_FILE="$STATE_DIR/c640-kbd-backlight.lock"
LAST_USER_FILE="$STATE_DIR/c640-kbd-backlight.last-user"
RESTORE_GEN_FILE="$STATE_DIR/c640-kbd-backlight.restore-gen"

# Optional: enable IdleMonitor polling via env (0=off default, 1=on)
C640_KBD_ENABLE_IDLEMONITOR="${C640_KBD_ENABLE_IDLEMONITOR:-0}"
# Force the legacy sysfs/ectool write path (A/B comparison, no D-Bus at all).
C640_KBD_FORCE_LEGACY="${C640_KBD_FORCE_LEGACY:-0}"
# Verbose monitor/debug logging (0=off default).
C640_KBD_DEBUG="${C640_KBD_DEBUG:-0}"

# D-Bus well-known paths / interfaces.
UP_PATH="/org/freedesktop/UPower/KbdBacklight"
UP_IFACE="org.freedesktop.UPower.KbdBacklight"
GSD_PATH="/org/gnome/SettingsDaemon/Power"
GSD_IFACE="org.gnome.SettingsDaemon.Power.Keyboard"
DBUS_PROPS="org.freedesktop.DBus.Properties"

# Backend availability.  Only the value "1" is cached: 0/empty are re-probed
# on every use so a long-running daemon can adopt gsd-power / UPower after
# their D-Bus names appear (and drop them when they disappear).
HAVE_GSD_KBD=""
HAVE_UPOWER_KBD=""
# Emit "backends probed: ..." once per process; later changes are transition
# logs so the journal stays readable while re-probing on every use.
_BACKENDS_LOGGED=0
restore_gen=0
# In-process mirror of the last user-visible brightness.  The value is also
# persisted to LAST_USER_FILE so save_state (which runs in a subshell) can read
# it.  A value of 0 means "the user explicitly turned the backlight off".
last_user_brightness=""
# Consecutive on-screen zero readings; two are required before a 0 is treated
# as user intent rather than gsd-power's transient blank-side write.
_C640_ZERO_STREAK=0
# -g keeps the array global even when this file is sourced from a function
# (used by the stub test harness).
declare -gA _C640_WARNED=()

log() {
    echo "[c640-kbd-backlight-sync] $*" >&2
}

# Warnings are always visible (stderr -> journald via the user unit).
log_warn() {
    echo "[WARN] [c640-kbd-backlight-sync] $*" >&2
}

# Rate-limited warning: each key is emitted at most once per process.
log_warn_once() {
    local key="$1"
    shift
    if [ -z "${_C640_WARNED[$key]:-}" ]; then
        _C640_WARNED[$key]=1
        log_warn "$@"
    fi
}

log_debug() {
    if [ "$C640_KBD_DEBUG" = "1" ]; then
        echo "[DEBUG] [c640-kbd-backlight-sync] $*" >&2
    fi
}

# Extract the first decimal number from a gdbus reply such as "(50,)" or
# "(<0>,)".  The int32 type token is stripped first so "<int32 50>" parses
# as 50 rather than 32.
parse_first_int() {
    local n
    n="$(printf '%s\n' "${1//int32 /}" | grep -o '[0-9][0-9]*' | head -n1 || true)"
    printf '%s' "$n"
}

# --- Backend probes -------------------------------------------------------

gsd_kbd_present() {
    local intro
    intro="$(timeout 3 gdbus introspect --session --dest org.gnome.SettingsDaemon.Power --object-path "$GSD_PATH" 2> /dev/null || true)"
    grep -q "Brightness" <<< "$intro"
}

upower_kbd_present() {
    local intro
    intro="$(timeout 3 gdbus introspect --system --dest org.freedesktop.UPower --object-path "$UP_PATH" 2> /dev/null || true)"
    grep -q "SetBrightness" <<< "$intro"
}

# Log a backend availability change (only when it actually changed).
log_backend_transition() {
    local name="$1" old="$2" new="$3"
    if [ "$old" = "$new" ]; then
        return 0
    fi
    if [ "$new" = "1" ]; then
        log "$name RECOVERED ($old -> 1); switching back to single writer"
    else
        log_warn "$name lost ($old -> 0); falling back"
    fi
}

ensure_backends() {
    # FORCE_LEGACY must be checked first: no gdbus call and no re-probe at all.
    if [ "$C640_KBD_FORCE_LEGACY" = "1" ]; then
        HAVE_GSD_KBD=0
        HAVE_UPOWER_KBD=0
        log "C640_KBD_FORCE_LEGACY=1: D-Bus backends disabled"
        return 0
    fi

    local old_gsd="$HAVE_GSD_KBD" old_upower="$HAVE_UPOWER_KBD"

    # TTL=0: only "1" is cached.  Re-probe on every use while a backend is
    # unavailable so a name that shows up later is picked up by this daemon.
    if [ "$HAVE_GSD_KBD" != "1" ]; then
        if command -v gdbus > /dev/null 2>&1 && gsd_kbd_present; then
            HAVE_GSD_KBD=1
        else
            HAVE_GSD_KBD=0
        fi
    fi
    if [ "$HAVE_UPOWER_KBD" != "1" ]; then
        if command -v gdbus > /dev/null 2>&1 && upower_kbd_present; then
            HAVE_UPOWER_KBD=1
        else
            HAVE_UPOWER_KBD=0
        fi
    fi

    if [ "$_BACKENDS_LOGGED" != "1" ]; then
        _BACKENDS_LOGGED=1
        log "backends probed: gsd=$HAVE_GSD_KBD upower=$HAVE_UPOWER_KBD"
        return 0
    fi
    log_backend_transition "gsd-power" "$old_gsd" "$HAVE_GSD_KBD"
    log_backend_transition "UPower" "$old_upower" "$HAVE_UPOWER_KBD"
}

# A failed runtime D-Bus call invalidates a cached "1": drop it so the next
# ensure_backends() re-probes instead of writing into a dead backend forever.
backend_runtime_failed() {
    local backend="$1" detail="$2" var name old
    if [ "$backend" = "gsd" ]; then
        var=HAVE_GSD_KBD
        name="gsd-power"
    else
        var=HAVE_UPOWER_KBD
        name="UPower"
    fi
    old="${!var}"
    if [ "$old" = "1" ]; then
        printf -v "$var" '%s' "0"
        log_warn "$name lost (1 -> 0) after $detail; falling back (re-probe on next use)"
    fi
}

# --- D-Bus helpers --------------------------------------------------------

upower_get_raw() {
    local out
    out="$(timeout 3 gdbus call --system --dest org.freedesktop.UPower --object-path "$UP_PATH" --method "$UP_IFACE.GetBrightness" 2> /dev/null)" || return 1
    parse_first_int "$out"
}

upower_set_raw() {
    timeout 3 gdbus call --system --dest org.freedesktop.UPower --object-path "$UP_PATH" --method "$UP_IFACE.SetBrightness" "$1" > /dev/null 2>&1
}

gsd_get_pct() {
    local out
    out="$(timeout 3 gdbus call --session --dest org.gnome.SettingsDaemon.Power --object-path "$GSD_PATH" --method "$DBUS_PROPS.Get" "$GSD_IFACE" Brightness 2> /dev/null)" || return 1
    parse_first_int "$out"
}

gsd_set_pct() {
    timeout 3 gdbus call --session --dest org.gnome.SettingsDaemon.Power --object-path "$GSD_PATH" --method "$DBUS_PROPS.Set" "$GSD_IFACE" Brightness "<int32 $1>" > /dev/null 2>&1
}

get_max() {
    local m
    m="$(cat "$SYSFS_MAX" 2> /dev/null || echo "")"
    if [[ "$m" =~ ^[0-9]+$ ]] && [ "$m" -gt 0 ]; then
        echo "$m"
    else
        echo 100
    fi
}

# --- ectool fallback helpers ---------------------------------------------

ectool_get_raw() {
    local pct=""
    local max
    if command -v ectool > /dev/null 2>&1; then
        pct="$(ectool pwmgetkblight 2> /dev/null | grep -o '[0-9][0-9]*' | head -n1 || echo "")"
        if ! [[ "$pct" =~ ^[0-9]+$ ]]; then
            pct="$(sudo -n ectool pwmgetkblight 2> /dev/null | grep -o '[0-9][0-9]*' | head -n1 || echo "")"
        fi
    elif [ -x /usr/local/bin/ectool ]; then
        pct="$(/usr/local/bin/ectool pwmgetkblight 2> /dev/null | grep -o '[0-9][0-9]*' | head -n1 || echo "")"
        if ! [[ "$pct" =~ ^[0-9]+$ ]]; then
            pct="$(sudo -n /usr/local/bin/ectool pwmgetkblight 2> /dev/null | grep -o '[0-9][0-9]*' | head -n1 || echo "")"
        fi
    fi
    if [[ "$pct" =~ ^[0-9]+$ ]]; then
        max="$(get_max)"
        if ! [[ "$max" =~ ^[0-9]+$ ]] || [ "$max" -eq 0 ]; then
            max=100
        fi
        echo $((pct * max / 100))
    else
        log_warn_once "ectool-read" "ectool pwmgetkblight unavailable or failed (sudo -n attempted)"
        echo ""
    fi
}

# Returns 0 when at least one ectool invocation (direct, sudo -n, or the
# /usr/local/bin copy) accepted the write, 1 when all of them failed.
ectool_set_pct() {
    local pct="$1"
    if command -v ectool > /dev/null 2>&1; then
        if ectool pwmsetkblight "$pct" > /dev/null 2>&1; then
            return 0
        fi
        if sudo -n ectool pwmsetkblight "$pct" > /dev/null 2>&1; then
            return 0
        fi
        log_warn_once "ectool-set" "ectool pwmsetkblight $pct failed even with sudo -n"
        return 1
    elif [ -x /usr/local/bin/ectool ]; then
        if /usr/local/bin/ectool pwmsetkblight "$pct" > /dev/null 2>&1; then
            return 0
        fi
        if sudo -n /usr/local/bin/ectool pwmsetkblight "$pct" > /dev/null 2>&1; then
            return 0
        fi
        log_warn_once "ectool-local-set" "/usr/local/bin/ectool pwmsetkblight $pct failed even with sudo -n"
        return 1
    fi
    log_warn_once "ectool-missing" "no ectool available for legacy fallback"
    return 1
}

# Returns 0 only when the write is confirmed.  A readable sysfs that does not
# show the target value is NOT a success even when echo/tee returned 0: only a
# successful ectool rescue can turn that into a success.  When sysfs cannot be
# read back at all, the write syscall result is trusted.
legacy_set_brightness() {
    local val="$1"
    local max="$2"
    local pct
    pct=$((val * 100 / max))

    if [ ! -f "$SYSFS_BRIGHTNESS" ]; then
        log_warn_once "legacy-no-sysfs" "$SYSFS_BRIGHTNESS missing; using ectool only"
        ectool_set_pct "$pct" || return 1
        return 0
    fi
    local write_ok=0
    if [ -w "$SYSFS_BRIGHTNESS" ]; then
        if echo "$val" > "$SYSFS_BRIGHTNESS" 2> /dev/null; then
            write_ok=1
        else
            log_warn_once "sysfs-write" "direct write to $SYSFS_BRIGHTNESS failed"
        fi
    else
        if echo "$val" | sudo -n tee "$SYSFS_BRIGHTNESS" > /dev/null 2>&1; then
            write_ok=1
        else
            log_warn_once "sysfs-sudo" "sudo -n tee $SYSFS_BRIGHTNESS failed (user service may lack passwordless sudo)"
        fi
    fi
    local cur
    cur="$(cat "$SYSFS_BRIGHTNESS" 2> /dev/null || echo "-1")"
    if [[ "$cur" =~ ^[0-9]+$ ]]; then
        if [ "$cur" -eq "$val" ]; then
            return 0
        fi
        log_warn_once "sysfs-verify" "sysfs verify mismatch ($cur != $val); falling back to ectool"
        if ectool_set_pct "$pct"; then
            return 0
        fi
        return 1
    fi
    # No readback possible: trust the write syscall (or let ectool try).
    if [ "$write_ok" -eq 1 ]; then
        return 0
    fi
    if ectool_set_pct "$pct"; then
        return 0
    fi
    return 1
}

# --- Read / write chain ---------------------------------------------------

get_brightness() {
    local raw=""
    if [ "$C640_KBD_FORCE_LEGACY" != "1" ]; then
        ensure_backends
        if [ "$HAVE_UPOWER_KBD" = "1" ]; then
            raw="$(upower_get_raw || echo "")"
            if [[ "$raw" =~ ^[0-9]+$ ]]; then
                echo "$raw"
                return 0
            fi
            log_warn_once "upower-get" "UPower GetBrightness failed; falling back to sysfs/ectool"
            backend_runtime_failed upower "GetBrightness failure"
        fi
    fi
    if [ -f "$SYSFS_BRIGHTNESS" ]; then
        local sys
        sys="$(cat "$SYSFS_BRIGHTNESS" 2> /dev/null || echo "")"
        if [[ "$sys" =~ ^[0-9]+$ ]]; then
            echo "$sys"
            return 0
        fi
    fi
    ectool_get_raw
}

# Verify a written value through any available readback path.  This
# deliberately does NOT consult HAVE_GSD_KBD/HAVE_UPOWER_KBD: the Phase 1
# backend re-probe caches those for write routing, while a verifier may still
# be readable (or may have just disappeared) independently of that cache.
# rc 0 = at least one verifier matches, 1 = every readable verifier disagrees,
# 2 = no readback path at all.
verify_brightness() {
    local want="$1"
    local found=0
    local raw
    if [ "$C640_KBD_FORCE_LEGACY" != "1" ]; then
        raw="$(upower_get_raw 2> /dev/null || echo "")"
        if [[ "$raw" =~ ^[0-9]+$ ]]; then
            found=1
            if [ "$raw" -eq "$want" ]; then
                return 0
            fi
        fi
    fi
    if [ -f "$SYSFS_BRIGHTNESS" ]; then
        raw="$(cat "$SYSFS_BRIGHTNESS" 2> /dev/null || echo "")"
        if [[ "$raw" =~ ^[0-9]+$ ]]; then
            found=1
            if [ "$raw" -eq "$want" ]; then
                return 0
            fi
        fi
    fi
    if [ "$found" -eq 1 ]; then
        return 1
    fi
    return 2
}

# rc 0 = at least one backend accepted the write and a readback (where
# available) confirmed the target; rc 1 = invalid value, every writer failed,
# or every readback disagreed.  A write with no readback path at all is
# accepted as authoritative, but emits a WARN.
set_brightness() {
    local val="$1"
    if ! [[ "$val" =~ ^-?[0-9]+$ ]]; then
        return 1
    fi
    local max
    max="$(get_max)"
    if ! [[ "$max" =~ ^[0-9]+$ ]] || [ "$max" -eq 0 ]; then
        max=100
    fi
    if [ "$val" -lt 0 ]; then
        val=0
    fi
    if [ "$val" -gt "$max" ]; then
        val="$max"
    fi

    ensure_backends
    local vrc=0

    # 1) gsd-power property (pct) is the single writer: it updates its own
    #    cache and drives UPower -> LED.  Availability is proven by a
    #    successful Properties.Get.
    if [ "$HAVE_GSD_KBD" = "1" ]; then
        local gpct
        gpct="$(gsd_get_pct || echo "")"
        if [[ "$gpct" =~ ^[0-9]+$ ]]; then
            local pct
            pct=$((val * 100 / max))
            if gsd_set_pct "$pct"; then
                if verify_brightness "$val"; then vrc=0; else vrc=$?; fi
                case "$vrc" in
                    0) return 0 ;;
                    2)
                        log_warn_once "verify-unavailable" "gsd-power write accepted but no brightness readback available; treating as success (WARN)"
                        return 0
                        ;;
                esac
                # vrc == 1: the write did not reach the LED.  The common cause
                # is kbd_brightness_now == value short-circuit: gsd-power
                # skipped the hardware write because its cache was already at
                # pct.  Re-setting the same property would short-circuit
                # again, so force the hardware via UPower -- then VERIFY it,
                # otherwise a "gsd fake success" would be mistaken for a
                # completed restore.
                if [ "$HAVE_UPOWER_KBD" = "1" ]; then
                    log_warn "gsd cache already at pct=$pct but brightness readback mismatch (expected $val); forcing hardware via UPower"
                    if upower_set_raw "$val"; then
                        if verify_brightness "$val"; then vrc=0; else vrc=$?; fi
                        if [ "$vrc" -eq 0 ]; then
                            return 0
                        fi
                        if [ "$vrc" -eq 2 ]; then
                            log_warn_once "verify-unavailable" "UPower repair accepted but no brightness readback available; treating as success (WARN)"
                            return 0
                        fi
                        log_warn "UPower repair for $val did not verify; continuing fallback"
                    else
                        log_warn "UPower SetBrightness $val failed during gsd-power repair"
                    fi
                fi
                # Fall through to the direct UPower / legacy writers.
            else
                log_warn_once "gsd-set" "gsd-power Properties.Set failed; trying UPower directly"
                backend_runtime_failed gsd "Properties.Set failure"
            fi
        else
            log_warn_once "gsd-get" "gsd-power Brightness Properties.Get failed; trying UPower directly"
            backend_runtime_failed gsd "Properties.Get failure"
        fi
    fi

    # 2) Direct UPower write.  gsd-power ignores UPower "external" signals,
    #    so its cache may stay out of sync -> warn once.  The write itself is
    #    not enough: read it back before declaring success.
    if [ "$HAVE_UPOWER_KBD" = "1" ]; then
        if upower_set_raw "$val"; then
            log_warn_once "upower-direct" "wrote UPower directly (raw=$val); gsd-power cache may be out of sync"
            if verify_brightness "$val"; then vrc=0; else vrc=$?; fi
            case "$vrc" in
                0) return 0 ;;
                2)
                    log_warn_once "verify-unavailable" "UPower write accepted but no brightness readback available; treating as success (WARN)"
                    return 0
                    ;;
            esac
            log_warn "UPower SetBrightness $val succeeded but readback mismatch; trying legacy fallback"
        else
            log_warn_once "upower-set" "UPower SetBrightness $val failed; falling back to legacy path"
            backend_runtime_failed upower "SetBrightness failure"
        fi
    fi

    # 3) Legacy sysfs / sudo tee / ectool fallback.  It performs its own
    #    readback for sysfs; ectool has no readback path and is authoritative
    #    when its set command succeeds.
    if [ "$HAVE_GSD_KBD" != "1" ] && [ "$HAVE_UPOWER_KBD" != "1" ]; then
        log_warn_once "no-dbus-backend" "gsd-power and UPower keyboard backends unavailable; using legacy sysfs/ectool path"
    fi
    legacy_set_brightness "$val" "$max" || return 1
    return 0
}

# --- ScreenSaver state helpers -------------------------------------------

screensaver_is_active() {
    local active=""
    if command -v gdbus > /dev/null 2>&1; then
        active="$(timeout 3 gdbus call --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver --method org.gnome.ScreenSaver.GetActive 2> /dev/null || echo "")"
        if ! grep -q "true" <<< "$active"; then
            active="$(timeout 3 gdbus call --session --dest org.freedesktop.ScreenSaver --object-path /org/freedesktop/ScreenSaver --method org.freedesktop.ScreenSaver.GetActive 2> /dev/null || echo "")"
        fi
        if grep -q "true" <<< "$active"; then
            echo "true"
        else
            echo "false"
        fi
    elif command -v busctl > /dev/null 2>&1; then
        active="$(busctl --user get-property org.gnome.ScreenSaver /org/gnome/ScreenSaver org.gnome.ScreenSaver Active 2> /dev/null || echo "")"
        if ! grep -q "true" <<< "$active"; then
            active="$(busctl --user get-property org.freedesktop.ScreenSaver /org/freedesktop/ScreenSaver org.freedesktop.ScreenSaver Active 2> /dev/null || echo "")"
        fi
        if grep -q "true" <<< "$active"; then
            echo "true"
        else
            echo "false"
        fi
    else
        echo "false"
    fi
}

read_last_user_brightness() {
    local v
    v="$(cat "$LAST_USER_FILE" 2> /dev/null || echo "")"
    # 0 is a legitimate recorded value: the user deliberately switched the
    # backlight off while the screen was on. It must reach save_state so a
    # later blank does not restore an old non-zero brightness.
    if [[ "$v" =~ ^[0-9]+$ ]]; then
        printf '%s' "$v"
    fi
}

# One sampler tick, kept separate from the infinite loop so it is unit
# testable. Only observations made while the screen is ON count as user
# intent; a blank-side transient 0 is ignored.
sample_brightness_once() {
    if [ "$(screensaver_is_active)" = "true" ]; then
        _C640_ZERO_STREAK=0
        return 0
    fi
    local b pct
    b="$(get_brightness)"
    if [[ "$b" =~ ^[0-9]+$ ]] && [ "$b" -ne 0 ]; then
        _C640_ZERO_STREAK=0
        last_user_brightness="$b"
        printf '%s\n' "$b" > "$LAST_USER_FILE" 2> /dev/null || true
        return 0
    fi
    if [[ "$b" =~ ^[0-9]+$ ]] && [ "$b" -eq 0 ]; then
        pct="$(gsd_get_pct 2> /dev/null || echo "")"
        # A non-zero gsd percentage means gsd still considers the light on;
        # the zero is a transient/hardware artefact, not user intent.
        if [[ "$pct" =~ ^[0-9]+$ ]] && [ "$pct" -ne 0 ]; then
            _C640_ZERO_STREAK=0
            return 0
        fi
        _C640_ZERO_STREAK=$((_C640_ZERO_STREAK + 1))
        if [ "$_C640_ZERO_STREAK" -ge 2 ]; then
            last_user_brightness=0
            printf '0\n' > "$LAST_USER_FILE" 2> /dev/null || true
            log "sampler: two consecutive on-screen zeros (gsd pct=0) -> recording explicit off"
        fi
    fi
}

brightness_sampler_loop() {
    log "brightness sampler started (interval 5s)"
    _C640_ZERO_STREAK=0
    while true; do
        sample_brightness_once
        sleep 5
    done
}

# A LAST_USER_FILE left behind by a previous daemon run is stale. Re-seed it
# from the brightness the user currently sees so the first blank after a
# restart saves the real value (including 0) instead of an old one.
seed_last_user_from_current() {
    if [ "$(screensaver_is_active)" = "true" ]; then
        return 0
    fi
    local cur
    cur="$(get_brightness)"
    if [[ "$cur" =~ ^[0-9]+$ ]]; then
        last_user_brightness="$cur"
        printf '%s\n' "$cur" > "$LAST_USER_FILE" 2> /dev/null || true
    fi
}

# --- State save / restore -------------------------------------------------

save_state() {
    # Atomic first-wins with flock on STATE_LOCK.  A numeric reading is
    # always saved (including 0); the sampler's last non-zero value is
    # preferred so a firmware-side blank does not lose user intent.
    (
        flock -n 200 || return 0
        if [ -f "$STATE_FILE" ]; then
            return 0
        fi
        local curr
        curr="$(read_last_user_brightness)"
        if [ -z "$curr" ]; then
            curr="$last_user_brightness"
        fi
        if [ -z "$curr" ]; then
            curr="$(get_brightness)"
        fi
        if ! [[ "$curr" =~ ^[0-9]+$ ]]; then
            return 0
        fi
        mkdir -p "$(dirname "$STATE_FILE")" 2> /dev/null || true
        local tmp
        tmp="$(mktemp "$STATE_DIR/.c640-kbd-XXXXXX" 2> /dev/null || mktemp "${TMPDIR:-/tmp}/.c640-kbd-XXXXXX")"
        echo "$curr" > "$tmp" 2> /dev/null || true
        chmod 600 "$tmp" 2> /dev/null || true
        mv -f "$tmp" "$STATE_FILE" 2> /dev/null || cp "$tmp" "$STATE_FILE" 2> /dev/null || true
        rm -f "$tmp" 2> /dev/null || true
        log "saved brightness $curr"
    ) 200> "$STATE_LOCK" || true
}

bump_restore_gen() {
    local g
    g="$(cat "$RESTORE_GEN_FILE" 2> /dev/null || echo 0)"
    if ! [[ "$g" =~ ^[0-9]+$ ]]; then
        g=0
    fi
    restore_gen=$((g + 1))
    printf '%s\n' "$restore_gen" > "$RESTORE_GEN_FILE" 2> /dev/null || true
}

# Crash recovery for the staging window: the value in PENDING is a restore
# that never reached finalize_restore().  If a new STATE_FILE exists it is
# newer (a blank saved it) and wins; otherwise the staged value is moved back
# so the next unblank can retry it.  Always returns 0 (safe to call in main).
recover_pending_state() {
    if [ ! -f "$RESTORE_PENDING_FILE" ]; then
        return 0
    fi
    if ! exec 204> "$STATE_LOCK"; then
        return 0
    fi
    if ! flock -n 204; then
        exec 204>&-
        return 0
    fi
    if [ -f "$STATE_FILE" ]; then
        rm -f "$RESTORE_PENDING_FILE" 2> /dev/null || true
        log "discarding interrupted restore (newer state already saved)"
    else
        if mv -f "$RESTORE_PENDING_FILE" "$STATE_FILE" 2> /dev/null; then
            log "recovered interrupted restore from $RESTORE_PENDING_FILE"
        else
            log_warn "cannot recover $RESTORE_PENDING_FILE to $STATE_FILE"
        fi
    fi
    flock -u 204
    exec 204>&-
    return 0
}

# Shared tail of every restore attempt.  PENDING is consumed only after the
# write succeeded; on failure it is rolled back to STATE_FILE (unless a newer
# blank already saved a replacement).  Returns the write's rc so the caller
# can report failure and re-arm retries.
#
# The state lock is taken BLOCKING here.  Every holder is a short critical
# section (save_state, a stage step, a retry's stage) and the slow brightness
# write is already finished before finalize runs, so waiting cannot deadlock.
# A non-blocking flock used to bail out on transient contention while PENDING
# held the only copy of the saved value: STATE_FILE was already staged away,
# so the PENDING guard made every later restore_state/cleanup skip forever
# until a daemon restart.  If flock (or the open) still fails, resolve PENDING
# anyway so it can never be orphaned.
finalize_restore() {
    local saved="$1" rc="$2" gen="$3"
    local have_lock=1
    if exec 203> "$STATE_LOCK"; then
        if ! flock 203; then
            log_warn "restore finalize (gen=$gen): flock failed; resolving PENDING without the lock"
            have_lock=0
        fi
    else
        log_warn "cannot open state lock $STATE_LOCK in finalize_restore; resolving PENDING without the lock"
        have_lock=0
    fi
    local newer=""
    if [ -f "$STATE_FILE" ]; then
        newer="$(cat "$STATE_FILE" 2> /dev/null || echo "")"
    fi
    if [ "$rc" -eq 0 ]; then
        rm -f "$RESTORE_PENDING_FILE" 2> /dev/null || true
        if [ -n "$newer" ] && [ "$newer" != "$saved" ]; then
            log "restore (gen=$gen) succeeded; keeping newer blank-time state $newer"
        fi
    else
        if [ -z "$newer" ]; then
            if ! mv -f "$RESTORE_PENDING_FILE" "$STATE_FILE" 2> /dev/null; then
                log_warn "restore failed (gen=$gen): could not roll staged value $saved back to $STATE_FILE"
            fi
        else
            rm -f "$RESTORE_PENDING_FILE" 2> /dev/null || true
            log "restore failed (gen=$gen): keeping newer blank-time state $newer"
        fi
        log_warn "restore failed (gen=$gen, rc=$rc): keeping brightness $saved for retry"
    fi
    if [ "$have_lock" -eq 1 ]; then
        flock -u 203
    fi
    exec 203>&-
    return "$rc"
}

schedule_restore_retries() {
    local gen="$1"
    shift
    local delay
    for delay in "$@"; do
        (
            sleep "$delay"
            local cur_gen
            cur_gen="$(cat "$RESTORE_GEN_FILE" 2> /dev/null || echo 0)"
            if [ "$cur_gen" != "$gen" ]; then
                log_debug "restore retry +${delay}s gen=$gen superseded by $cur_gen"
                exit 0
            fi
            # Recovery is startup-only: a PENDING that still exists here can
            # only belong to a restore that is mid-write, so never adopt it.
            if [ ! -f "$STATE_FILE" ]; then
                exit 0
            fi
            if [ "$(screensaver_is_active)" = "true" ]; then
                exit 0
            fi
            if ! exec 202> "$STATE_LOCK"; then
                exit 0
            fi
            if ! flock -n 202; then
                exec 202>&-
                exit 0
            fi
            # Re-check the generation while holding the lock, so a restore
            # that started after this retry was scheduled cannot be undone.
            cur_gen="$(cat "$RESTORE_GEN_FILE" 2> /dev/null || echo 0)"
            if [ "$cur_gen" != "$gen" ]; then
                flock -u 202
                exec 202>&-
                exit 0
            fi
            local saved
            saved="$(cat "$STATE_FILE" 2> /dev/null || echo "")"
            if ! [[ "$saved" =~ ^[0-9]+$ ]]; then
                rm -f "$STATE_FILE" 2> /dev/null || true
                flock -u 202
                exec 202>&-
                exit 0
            fi
            # Stage before writing, exactly like the initial restore: a blank
            # during the write can still save a newer value to STATE_FILE.
            if ! mv -f "$STATE_FILE" "$RESTORE_PENDING_FILE" 2> /dev/null; then
                flock -u 202
                exec 202>&-
                exit 0
            fi
            flock -u 202
            exec 202>&-
            log "restore retry +${delay}s (gen=$gen): restoring brightness $saved"
            local rc=0
            if set_brightness "$saved"; then rc=0; else rc=$?; fi
            # No recursive re-schedule: a failing backend would otherwise
            # create a retry storm.  The state file is left in place for the
            # next unblank event.
            finalize_restore "$saved" "$rc" "$gen" || true
            exit 0
        ) &
    done
}

restore_state() {
    if ! exec 201> "$STATE_LOCK"; then
        log_warn "cannot open state lock $STATE_LOCK"
        return 1
    fi
    if ! flock -n 201; then
        exec 201>&-
        return 0
    fi

    # PENDING is the marker for a restore between stage and finalize.  Such a
    # restore has released STATE_LOCK for the slow D-Bus write, so a second
    # monitor source can reach this point while its value is staged.  Leave
    # that value (and the generation) alone: its own finalize, or the daemon
    # restart, owns it.  Crash recovery therefore runs only in main().
    if [ -f "$RESTORE_PENDING_FILE" ]; then
        log "restore skipped: another restore is in progress (staged value pending)"
        flock -u 201
        exec 201>&-
        return 0
    fi

    # Bump the generation only after owning the lock: two concurrent restores
    # can no longer stamp the file with the same generation and let a stale
    # scheduled retry through.
    bump_restore_gen
    local gen="$restore_gen"

    local saved
    saved="$(cat "$STATE_FILE" 2> /dev/null || echo "")"
    if ! [[ "$saved" =~ ^[0-9]+$ ]]; then
        log_warn "discarding invalid saved brightness '$saved'"
        rm -f "$STATE_FILE" "$RESTORE_PENDING_FILE" 2> /dev/null || true
        flock -u 201
        exec 201>&-
        return 0
    fi

    # Defer while the screen is still active (re-blank race, TROUBLESHOOTING
    # §11), but converge via +0.5s/+1.5s/+3s retries.  Old retries are
    # invalidated by the generation counter; keeping the state makes the
    # retries meaningful (and lets a later unblank restore it too).
    if [ "$(screensaver_is_active)" = "true" ]; then
        log "restore deferred: ScreenSaver still active (gen=$gen)"
        flock -u 201
        exec 201>&-
        schedule_restore_retries "$gen" 0.5 1.5 3
        return 0
    fi

    # A valid 0 goes through the exact same write path as any other value:
    # "0" means the user explicitly switched the light off and MUST be
    # written, otherwise a non-zero residual brightness survives the restore.
    # Stage the value to PENDING so a blank arriving during the write can
    # still save_state() its new value into STATE_FILE.
    if ! mv -f "$STATE_FILE" "$RESTORE_PENDING_FILE" 2> /dev/null; then
        log_warn "cannot stage saved brightness $saved; keeping $STATE_FILE"
        flock -u 201
        exec 201>&-
        return 1
    fi
    log "restoring brightness $saved"
    # Release the state lock BEFORE the D-Bus write. set_brightness can block
    # for several seconds (gdbus timeouts); a blank arriving in that window
    # must still be able to save_state() the new value with flock -n.
    flock -u 201
    exec 201>&-

    local rc=0
    if set_brightness "$saved"; then rc=0; else rc=$?; fi
    if finalize_restore "$saved" "$rc" "$gen"; then :; else rc=$?; fi

    if [ "$rc" -ne 0 ]; then
        # Re-arm the same generation once; retries themselves do not recurse.
        schedule_restore_retries "$gen" 0.5 1.5 3
        return 1
    fi
    return 0
}

# --- Blank / unblank guards ----------------------------------------------

guard_blank() {
    local delay
    for delay in 0.25 1.0; do
        (
            sleep "$delay"
            # Only an explicit "true" counts as active; every other value
            # (including a future tristate "unknown") means inactive.
            if [ "$(screensaver_is_active)" = "true" ]; then
                : # active: verify the light is really off
            else
                exit 0
            fi
            local cur
            cur="$(get_brightness)"
            if [[ "$cur" =~ ^[0-9]+$ ]] && [ "$cur" -ne 0 ]; then
                log_warn "blank guard +${delay}s: brightness=$cur while ScreenSaver active; forcing 0"
                local grc=0
                if set_brightness 0; then grc=0; else grc=$?; fi
                if [ "$grc" -ne 0 ]; then
                    log_warn "blank guard +${delay}s: failed to force 0 (rc=$grc)"
                fi
            fi
        ) &
    done
}

guard_unblank() {
    local saved="$1"
    local max
    max="$(get_max)"
    if ! [[ "$max" =~ ^[0-9]+$ ]] || [ "$max" -eq 0 ]; then
        max=100
    fi
    local want_pct
    want_pct=$((saved * 100 / max))
    local delay
    for delay in 0.3 0.9; do
        (
            # This runs in a subshell: it cannot write HAVE_* back to the
            # parent, but it does give this guard the freshest backend state.
            ensure_backends
            sleep "$delay"
            if [ "$(screensaver_is_active)" = "true" ]; then
                exit 0
            fi
            local ok=0
            local raw
            raw="$(get_brightness)"
            if [ "$raw" = "$saved" ]; then
                ok=1
            fi
            if [ "$HAVE_GSD_KBD" = "1" ]; then
                local gpct
                gpct="$(gsd_get_pct || echo "")"
                if [ "$gpct" != "$want_pct" ]; then
                    ok=0
                fi
            fi
            if [ "$ok" -ne 1 ]; then
                log_warn "unblank guard +${delay}s: brightness mismatch (raw=$raw, want=$saved); re-setting"
                local grc=0
                if set_brightness "$saved"; then grc=0; else grc=$?; fi
                if [ "$grc" -ne 0 ]; then
                    log_warn "unblank guard +${delay}s: re-set failed (rc=$grc)"
                fi
            fi
        ) &
    done
}

handle_blank() {
    save_state
    local rc=0
    if set_brightness 0; then rc=0; else rc=$?; fi
    if [ "$rc" -ne 0 ]; then
        log_warn "blank: failed to switch keyboard backlight off (rc=$rc)"
    fi
    guard_blank
}

handle_unblank() {
    local saved=""
    if [ -f "$STATE_FILE" ]; then
        saved="$(cat "$STATE_FILE" 2> /dev/null || echo "")"
    fi
    local rc=0
    if restore_state; then rc=0; else rc=$?; fi
    if [ "$rc" -ne 0 ]; then
        log_warn "unblank: restore failed (rc=$rc)"
    elif [[ "$saved" =~ ^[0-9]+$ ]] && [ "$saved" -ne 0 ]; then
        guard_unblank "$saved"
    fi
}

is_screensaver_available() {
    if command -v gdbus > /dev/null 2>&1; then
        timeout 3 gdbus introspect --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver 2> /dev/null | grep -q "ActiveChanged" && return 0
        timeout 3 gdbus introspect --session --dest org.freedesktop.ScreenSaver --object-path /org/freedesktop/ScreenSaver 2> /dev/null | grep -q "ActiveChanged" && return 0
    fi
    if command -v busctl > /dev/null 2>&1; then
        busctl --user status org.gnome.ScreenSaver 2> /dev/null | grep -q "org.gnome.ScreenSaver" && return 0
        busctl --user status org.freedesktop.ScreenSaver 2> /dev/null | grep -q "org.freedesktop.ScreenSaver" && return 0
        busctl --user get-property org.gnome.ScreenSaver /org/gnome/ScreenSaver org.gnome.ScreenSaver Active 2> /dev/null | grep -q "b " && return 0
    fi
    return 1
}

monitor_screensaver_dbus_monitor() {
    # Monitor both GNOME and freedesktop ScreenSaver (covers GNOME Wayland + KDE/Sway fallback)
    # shellcheck disable=SC2094
    dbus-monitor --session "type='signal',interface='org.gnome.ScreenSaver',member='ActiveChanged'" "type='signal',interface='org.freedesktop.ScreenSaver',member='ActiveChanged'" 2> /dev/null | while IFS= read -r line; do
        log_debug "dbus-monitor: $line"
        # Filter to ScreenSaver interfaces only - dbus-monitor already filtered, but keep guard for gdbus fallback
        if echo "$line" | grep -q "ActiveChanged"; then
            # Need to read next lines for boolean value; we handle per-line boolean
            continue
        fi
        case "$line" in
            *boolean\ true*)
                log "ScreenSaver active -> saving and turning off kbd backlight"
                handle_blank || log_warn "dbus-monitor: blank handler failed"
                ;;
            *boolean\ false*)
                log "ScreenSaver inactive -> restoring kbd backlight"
                sleep 0.5
                handle_unblank || log_warn "dbus-monitor: unblank handler failed"
                ;;
        esac
    done
}

monitor_screensaver_gdbus() {
    # Fallback via gdbus monitor: watch both destinations without --dest filter
    gdbus monitor --session 2> /dev/null | while IFS= read -r line; do
        log_debug "gdbus monitor: $line"
        if echo "$line" | grep -q "ActiveChanged"; then
            if echo "$line" | grep -q "org.gnome.ScreenSaver\|org.freedesktop.ScreenSaver"; then
                if echo "$line" | grep -q "true"; then
                    log "ScreenSaver active (gdbus) -> off"
                    handle_blank || log_warn "gdbus monitor: blank handler failed"
                elif echo "$line" | grep -q "false"; then
                    log "ScreenSaver inactive (gdbus) -> restore"
                    sleep 0.5
                    handle_unblank || log_warn "gdbus monitor: unblank handler failed"
                fi
            fi
        fi
    done
}

monitor_login1() {
    dbus-monitor --system "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" 2> /dev/null | while IFS= read -r line; do
        log_debug "login1: $line"
        case "$line" in
            *boolean\ true*)
                log "PrepareForSleep true -> saving"
                save_state
                ;;
            *boolean\ false*)
                log "PrepareForSleep false -> restore after delay"
                sleep 0.6
                restore_state || log_warn "login1: restore failed"
                ;;
        esac
    done
}

idle_poll_loop() {
    if ! command -v gsettings > /dev/null 2>&1; then
        return 0
    fi
    if ! command -v gdbus > /dev/null 2>&1; then
        return 0
    fi
    if ! timeout 3 gdbus introspect --session --dest org.gnome.Mutter.IdleMonitor --object-path /org/gnome/Mutter/IdleMonitor/Core 2> /dev/null | grep -q "GetIdletime"; then
        log "Mutter IdleMonitor not available, idle polling disabled"
        return 0
    fi
    local idle_delay
    idle_delay="$(gsettings get org.gnome.desktop.session idle-delay 2> /dev/null | grep -o '[0-9][0-9]*' || echo 300)"
    if ! [[ "$idle_delay" =~ ^[0-9]+$ ]] || [ "$idle_delay" -eq 0 ]; then
        log "idle-delay 0, idle polling disabled"
        return 0
    fi
    local threshold
    threshold=$(((idle_delay + 5) * 1000))
    log "idle polling enabled: idle-delay=${idle_delay}s threshold=${threshold}ms"
    local was_idle=0
    while true; do
        local idletime
        idletime="$(timeout 3 gdbus call --session --dest org.gnome.Mutter.IdleMonitor --object-path /org/gnome/Mutter/IdleMonitor/Core --method org.gnome.Mutter.IdleMonitor.GetIdletime 2> /dev/null | grep -o '[0-9][0-9]*' | head -n1 || echo 0)"
        if ! [[ "$idletime" =~ ^[0-9]+$ ]]; then
            idletime=0
        fi
        if [ "$idletime" -ge "$threshold" ]; then
            if [ "$was_idle" -eq 0 ]; then
                log "idle threshold reached (${idletime}ms) -> off"
                handle_blank || log_warn "idle poll: blank handler failed"
                was_idle=1
            fi
        else
            if [ "$was_idle" -eq 1 ]; then
                log "user active (idletime ${idletime}ms) -> restore"
                sleep 0.5
                handle_unblank || log_warn "idle poll: unblank handler failed"
                was_idle=0
            fi
        fi
        sleep 5
    done
}

print_help() {
    echo "Usage: $0 [OPTIONS]"
    echo "  --help, -h           Show help"
    echo "  --test-blank         Simulate screen blank (save + set 0)"
    echo "  --test-unblank       Simulate screen unblank (restore)"
    echo "  --check              Check status"
    echo "  --daemon             Run daemon (default)"
    echo ""
    echo "Env:"
    echo "  C640_KBD_ENABLE_IDLEMONITOR=1  Enable Mutter IdleMonitor polling"
    echo "  C640_KBD_FORCE_LEGACY=1        Force sysfs/ectool path (no D-Bus)"
    echo "  C640_KBD_DEBUG=1               Verbose monitor/debug logging"
    echo "  C640_KBD_SYSFS_BRIGHTNESS=PATH Override sysfs brightness path"
    echo "  C640_KBD_SYSFS_MAX=PATH        Override sysfs max_brightness path"
}

check_status() {
    echo "=== c640-kbd-backlight-sync status ==="
    echo "SYSFS: $SYSFS_BRIGHTNESS"
    if [ -f "$SYSFS_BRIGHTNESS" ]; then
        echo "  brightness: $(cat "$SYSFS_BRIGHTNESS" 2> /dev/null || echo "?") / $(cat "$SYSFS_MAX" 2> /dev/null || echo "?")"
    else
        echo "  NOT FOUND"
    fi
    echo "STATE_FILE: $STATE_FILE"
    if [ -f "$STATE_FILE" ]; then
        echo "  saved: $(cat "$STATE_FILE")"
    else
        echo "  (no saved state)"
    fi
    echo "Daemon running: $(pgrep -f "[c]640-kbd-backlight-sync" > /dev/null && echo yes || echo no)"
    echo "ScreenSaver available: $(is_screensaver_available && echo yes || echo no)"
    echo "IdleMonitor enabled: $C640_KBD_ENABLE_IDLEMONITOR"
    ensure_backends
    echo "gsd-power keyboard backend: $([ "$HAVE_GSD_KBD" = "1" ] && echo yes || echo no)"
    echo "UPower keyboard backend: $([ "$HAVE_UPOWER_KBD" = "1" ] && echo yes || echo no)"
    echo "UPower raw: $(upower_get_raw 2> /dev/null || echo "?")"
    echo "gsd-power pct: $(gsd_get_pct 2> /dev/null || echo "?")"
    if command -v gdbus > /dev/null 2>&1; then
        echo "gdbus: available"
    else
        echo "gdbus: not found"
    fi
    if command -v dbus-monitor > /dev/null 2>&1; then
        echo "dbus-monitor: available"
    else
        echo "dbus-monitor: not found"
    fi
}

cleanup() {
    log "cleanup: restoring if needed"
    local rc=0
    if restore_state; then rc=0; else rc=$?; fi
    if [ "$rc" -ne 0 ]; then
        log_warn "cleanup restore failed (rc=$rc); saved state was kept for retry"
    fi
    # kill background jobs
    jobs -p | xargs -r kill 2> /dev/null || true
    exit 0
}

main() {
    # Recover a value stranded by a crash between restore staging and finalize.
    recover_pending_state

    # Handle CLI (semantics unchanged; --test-* do not touch ScreenSaver).
    if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
        print_help
        exit 0
    fi
    if [ "${1:-}" = "--test-blank" ]; then
        save_state
        local rc=0
        if set_brightness 0; then rc=0; else rc=$?; fi
        if [ "$rc" -ne 0 ]; then
            echo "simulated blank: failed to set 0 (rc=$rc)" >&2
            exit 1
        fi
        echo "simulated blank: saved and set 0"
        exit 0
    fi
    if [ "${1:-}" = "--test-unblank" ]; then
        local rc=0
        if restore_state; then rc=0; else rc=$?; fi
        if [ "$rc" -ne 0 ]; then
            echo "simulated unblank: restore failed (rc=$rc)" >&2
            exit 1
        fi
        echo "simulated unblank: restored"
        exit 0
    fi
    if [ "${1:-}" = "--check" ]; then
        check_status
        exit 0
    fi

    # Probe gsd-power / UPower once at daemon start.
    ensure_backends

    if [ ! -f "$SYSFS_BRIGHTNESS" ] && [ "$HAVE_UPOWER_KBD" != "1" ] && ! command -v ectool > /dev/null 2>&1 && [ ! -x /usr/local/bin/ectool ]; then
        log "no backlight interface found, exiting"
        exit 0
    fi

    # Single instance per user via flock (secure per-user lock)
    umask 077
    mkdir -p "$STATE_DIR" 2> /dev/null || true
    chmod 700 "$STATE_DIR" 2> /dev/null || true
    # Open lock file securely.  Never redirect stderr here: daemon warnings
    # must reach the journal (see the unit's StandardError=journal).
    if ! exec 9> "$LOCK_FILE"; then
        log "cannot open lock file $LOCK_FILE, exiting"
        exit 1
    fi
    chmod 600 "$LOCK_FILE" 2> /dev/null || true
    if ! flock -n 9; then
        log "another instance is running, exiting"
        exit 0
    fi

    trap cleanup TERM INT EXIT HUP

    log "starting; SYSFS=$SYSFS_BRIGHTNESS STATE=$STATE_FILE IdleMonitor=$C640_KBD_ENABLE_IDLEMONITOR Legacy=$C640_KBD_FORCE_LEGACY"

    # Discard any last-user value persisted by a previous daemon run.
    seed_last_user_from_current

    # Always-on sampler for the last user-visible brightness (0 = explicit off).
    brightness_sampler_loop &

    # Start optional idle polling in background
    if [ "$C640_KBD_ENABLE_IDLEMONITOR" = "1" ]; then
        idle_poll_loop &
    fi

    # Start login1 monitor in background if dbus-monitor available (with retry)
    if command -v dbus-monitor > /dev/null 2>&1; then
        (while true; do
            monitor_login1 || log "login1 monitor exited $?, retry in 2s"
            sleep 2
        done) &
    fi

    # Main screensaver monitor (foreground) with retry to avoid Restart storm
    # dbus-monitor may exit if session bus disappears (e.g. gnome-shell restart)
    if command -v dbus-monitor > /dev/null 2>&1; then
        while true; do
            monitor_screensaver_dbus_monitor || log "dbus-monitor exited $?, retry in 2s"
            sleep 2
        done &
        wait || true
    else
        if command -v gdbus > /dev/null 2>&1; then
            log "dbus-monitor not found, falling back to gdbus"
            while true; do
                monitor_screensaver_gdbus || log "gdbus monitor exited $?, retry in 2s"
                sleep 2
            done &
            wait || true
        else
            log "no dbus monitor tool found, entering poll loop"
            prev=""
            while true; do
                active=""
                if command -v gdbus > /dev/null 2>&1; then
                    active="$(timeout 3 gdbus call --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver --method org.gnome.ScreenSaver.GetActive 2> /dev/null || echo "")"
                    if ! grep -q "true" <<< "$active"; then
                        active="$(timeout 3 gdbus call --session --dest org.freedesktop.ScreenSaver --object-path /org/freedesktop/ScreenSaver --method org.freedesktop.ScreenSaver.GetActive 2> /dev/null || echo "")"
                    fi
                    if grep -q "true" <<< "$active"; then
                        active="true"
                    else
                        active="false"
                    fi
                elif command -v busctl > /dev/null 2>&1; then
                    active="$(busctl --user get-property org.gnome.ScreenSaver /org/gnome/ScreenSaver org.gnome.ScreenSaver Active 2> /dev/null || echo "")"
                    if ! grep -q "true" <<< "$active"; then
                        active="$(busctl --user get-property org.freedesktop.ScreenSaver /org/freedesktop/ScreenSaver org.freedesktop.ScreenSaver Active 2> /dev/null || echo "")"
                    fi
                    if grep -q "true" <<< "$active"; then
                        active="true"
                    else
                        active="false"
                    fi
                else
                    sleep 5
                    continue
                fi
                if [ "$active" != "$prev" ]; then
                    if [ "$active" = "true" ]; then
                        handle_blank || log_warn "poll loop: blank handler failed"
                    else
                        sleep 0.5
                        handle_unblank || log_warn "poll loop: unblank handler failed"
                    fi
                    prev="$active"
                fi
                sleep 2
            done
        fi
    fi
}

