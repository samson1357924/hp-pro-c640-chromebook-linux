#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 Samson <https://github.com/samson1357924>
# c640-kbd-backlight-sync - Keyboard backlight sync with screen blank
# Monitors org.gnome.ScreenSaver / org.freedesktop.ScreenSaver ActiveChanged
# (Wayland/X11) and org.freedesktop.login1 PrepareForSleep (S3) to turn off
# keyboard backlight when screen goes dark and restore it when screen lights up.
#
# Write chain (single-writer aware):
#   gsd-power Keyboard.Brightness (pct) -> UPower SetBrightness (raw) -> LED.
#   UPower's "external" signals are ignored by gsd-power, so writing UPower
#   alone leaves gsd-power's cache stale.  We therefore write the property
#   first and only fall back to direct UPower / sysfs / ectool writes.
#
# State is stored atomically in $XDG_RUNTIME_DIR/c640-kbd-backlight.state.
# A 5s sampler keeps the last user-visible brightness (0 = user explicitly
# switched it off) so a blank can be saved even when the LED was already
# turned off by firmware.
set -euo pipefail

# Restore / handoff result-code contract.  Only RC_DONE means "work actually
# completed and was verified", and is therefore the only code allowed to
# consume HANDOFF_RESUME_FILE / STATE_FILE.  RC_DEFER is retryable contention
# or an active/unknown screen (keep flag, handoff and state); RC_FAIL is an
# invalid input or an I/O failure (keep everything and warn).
RC_DONE=0
RC_FAIL=1
RC_DEFER=2

# Optional sysfs overrides (mainly for testing / non-standard kernels).
SYSFS_BRIGHTNESS="${C640_KBD_SYSFS_BRIGHTNESS:-/sys/class/leds/chromeos::kbd_backlight/brightness}"
SYSFS_MAX="${C640_KBD_SYSFS_MAX:-/sys/class/leds/chromeos::kbd_backlight/max_brightness}"

# Secure per-user state directory
# Prefer XDG_RUNTIME_DIR, fallback to /run/user/<uid>, then secure tmp
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ]; then
    STATE_DIR="$XDG_RUNTIME_DIR"
elif [ -d "/run/user/$(id -u 2> /dev/null || echo 1000)" ] && [ -w "/run/user/$(id -u 2> /dev/null || echo 1000)" ]; then
    STATE_DIR="/run/user/$(id -u 2> /dev/null || echo 1000)"
else
    STATE_DIR="${TMPDIR:-/tmp}/c640-kbd-$(id -u 2> /dev/null || echo 1000)"
    mkdir -p "$STATE_DIR" 2> /dev/null || true
    chmod 700 "$STATE_DIR" 2> /dev/null || true
fi
STATE_FILE="$STATE_DIR/c640-kbd-backlight.state"
# Phase 4b handoff files.  The root sleep hook publishes the pre-suspend
# brightness and the post-thaw flag into the user's runtime dir; the daemon
# adopts them after thaw and is the ONLY writer of the restored brightness.
# Both env overrides are for the unit test; production uses the same dir as
# STATE_FILE (i.e. $XDG_RUNTIME_DIR).
HANDOFF_SUSPEND_FILE="${C640_KBD_HANDOFF_SUSPEND:-$STATE_DIR/c640-kbd-backlight.suspend}"
HANDOFF_RESUME_FILE="${C640_KBD_HANDOFF_RESUME:-$STATE_DIR/c640-kbd-backlight.resume}"
# Staging file used while a restore write is in flight.  STATE_FILE is renamed
# here just before the (potentially slow) write, so a blank arriving mid-write
# can still store its new value in STATE_FILE; the staged value is consumed
# only after the write has been verified.
RESTORE_PENDING_FILE="${C640_KBD_RESTORE_PENDING_FILE:-$STATE_DIR/c640-kbd-backlight.restore-pending}"
STATE_LOCK="$STATE_DIR/c640-kbd-backlight.state.lock"
LOCK_FILE="$STATE_DIR/c640-kbd-backlight.lock"
# Separate lock so the login1 monitor, the 5s sampler and the startup handler
# cannot all enter handle_resume() at once (which would issue two gsd writes).
RESUME_LOCK="${C640_KBD_RESUME_LOCK:-$STATE_DIR/c640-kbd-backlight.resume.lock}"
LAST_USER_FILE="$STATE_DIR/c640-kbd-backlight.last-user"
# Sidecar metadata for LAST_USER_FILE: how the value was recorded and when.
# A "manual0" record means the sampler saw two consecutive on-screen zeros,
# i.e. the user explicitly switched the light off.  It is only honoured for
# C640_KBD_LAST_USER_TTL seconds while gsd-power still reports 0, so a live
# non-zero reading after the user brightens again is not mistaken for a
# firmware residue.
LAST_USER_META_FILE="${C640_KBD_LAST_USER_META_FILE:-$LAST_USER_FILE.meta}"
C640_KBD_LAST_USER_TTL="${C640_KBD_LAST_USER_TTL:-15}"
RESTORE_GEN_FILE="$STATE_DIR/c640-kbd-backlight.restore-gen"

# Optional: enable IdleMonitor polling via env (0=off default, 1=on)
C640_KBD_ENABLE_IDLEMONITOR="${C640_KBD_ENABLE_IDLEMONITOR:-0}"
# Force the legacy sysfs/ectool write path (A/B comparison, no D-Bus at all).
C640_KBD_FORCE_LEGACY="${C640_KBD_FORCE_LEGACY:-0}"
# Verbose monitor/debug logging (0=off default).
C640_KBD_DEBUG="${C640_KBD_DEBUG:-0}"
# Resume convergence: poll ScreenSaver for up to ~6s (0.2+0.4+0.8+1.6+3.2)
# after thaw, capped by C640_KBD_RESUME_PROBE_MAX seconds.  Set to 0 in tests
# to make "unknown" converge immediately.  An explicit opt-in is required to
# restore while the ScreenSaver answer is still unknown.
C640_KBD_RESUME_PROBE_MAX="${C640_KBD_RESUME_PROBE_MAX:-10}"
C640_KBD_RESUME_ALLOW_UNKNOWN="${C640_KBD_RESUME_ALLOW_UNKNOWN:-0}"

# D-Bus well-known paths / interfaces.
UP_PATH="/org/freedesktop/UPower/KbdBacklight"
UP_IFACE="org.freedesktop.UPower.KbdBacklight"
GSD_PATH="/org/gnome/SettingsDaemon/Power"
GSD_IFACE="org.gnome.SettingsDaemon.Power.Keyboard"
DBUS_PROPS="org.freedesktop.DBus.Properties"

# Backend availability.  Only the value "1" is cached: 0/empty are re-probed
# on every use so a long-running daemon can adopt gsd-power / UPower after
# their D-Bus names appear (and drop them when they disappear).
HAVE_GSD_KBD=""
HAVE_UPOWER_KBD=""
# Emit "backends probed: ..." once per process; later changes are transition
# logs so the journal stays readable while re-probing on every use.
_BACKENDS_LOGGED=0
restore_gen=0
# In-process mirror of the last user-visible brightness.  The value is also
# persisted to LAST_USER_FILE so save_state (which runs in a subshell) can read
# it.  A value of 0 means "the user explicitly turned the backlight off".
last_user_brightness=""
# Consecutive on-screen zero readings; two are required before a 0 is treated
# as user intent rather than gsd-power's transient blank-side write.
_C640_ZERO_STREAK=0
log() {
    echo "[c640-kbd-backlight-sync] $*" >&2
}

# Warnings are always visible (stderr -> journald via the user unit).
log_warn() {
    echo "[WARN] [c640-kbd-backlight-sync] $*" >&2
}

# Rate-limited warning: each key is emitted at most once per runtime dir.
# A marker FILE is used instead of an in-process array: most callers run in a
# subshell (command substitutions, the retry/guard subshells, handle_resume
# and the 5s sampler that calls it), so an array update there never reaches
# the parent and "once" silently degraded to "every poll".  A marker in the
# state dir is visible to every subshell; TOCTOU (two subshells logging the
# same key at once) is harmless.
log_warn_once() {
    local key="$1"
    shift
    local marker="$STATE_DIR/.warned.$key"
    if [ -e "$marker" ]; then
        return 0
    fi
    mkdir -p "$STATE_DIR" 2> /dev/null || true
    : > "$marker" 2> /dev/null || true
    log_warn "$@"
}

log_debug() {
    if [ "$C640_KBD_DEBUG" = "1" ]; then
        echo "[DEBUG] [c640-kbd-backlight-sync] $*" >&2
    fi
}

# Extract the first decimal number from a gdbus reply such as "(50,)" or
# "(<0>,)".  The int32 type token is stripped first so "<int32 50>" parses
# as 50 rather than 32.
parse_first_int() {
    local n
    n="$(printf '%s\n' "${1//int32 /}" | grep -o '[0-9][0-9]*' | head -n1 || true)"
    printf '%s' "$n"
}

# --- Backend probes -------------------------------------------------------

gsd_kbd_present() {
    local intro
    intro="$(timeout 3 gdbus introspect --session --dest org.gnome.SettingsDaemon.Power --object-path "$GSD_PATH" 2> /dev/null || true)"
    grep -q "Brightness" <<< "$intro"
}

upower_kbd_present() {
    local intro
    intro="$(timeout 3 gdbus introspect --system --dest org.freedesktop.UPower --object-path "$UP_PATH" 2> /dev/null || true)"
    grep -q "SetBrightness" <<< "$intro"
}

# Log a backend availability change (only when it actually changed).
log_backend_transition() {
    local name="$1" old="$2" new="$3"
    if [ "$old" = "$new" ]; then
        return 0
    fi
    if [ "$new" = "1" ]; then
        log "$name RECOVERED ($old -> 1); switching back to single writer"
    else
        log_warn "$name lost ($old -> 0); falling back"
    fi
}

ensure_backends() {
    # FORCE_LEGACY must be checked first: no gdbus call and no re-probe at all.
    if [ "$C640_KBD_FORCE_LEGACY" = "1" ]; then
        HAVE_GSD_KBD=0
        HAVE_UPOWER_KBD=0
        log "C640_KBD_FORCE_LEGACY=1: D-Bus backends disabled"
        return 0
    fi

    local old_gsd="$HAVE_GSD_KBD" old_upower="$HAVE_UPOWER_KBD"

    # TTL=0: only "1" is cached.  Re-probe on every use while a backend is
    # unavailable so a name that shows up later is picked up by this daemon.
    if [ "$HAVE_GSD_KBD" != "1" ]; then
        if command -v gdbus > /dev/null 2>&1 && gsd_kbd_present; then
            HAVE_GSD_KBD=1
        else
            HAVE_GSD_KBD=0
        fi
    fi
    if [ "$HAVE_UPOWER_KBD" != "1" ]; then
        if command -v gdbus > /dev/null 2>&1 && upower_kbd_present; then
            HAVE_UPOWER_KBD=1
        else
            HAVE_UPOWER_KBD=0
        fi
    fi

    if [ "$_BACKENDS_LOGGED" != "1" ]; then
        _BACKENDS_LOGGED=1
        log "backends probed: gsd=$HAVE_GSD_KBD upower=$HAVE_UPOWER_KBD"
        return 0
    fi
    log_backend_transition "gsd-power" "$old_gsd" "$HAVE_GSD_KBD"
    log_backend_transition "UPower" "$old_upower" "$HAVE_UPOWER_KBD"
}

# A failed runtime D-Bus call invalidates a cached "1": drop it so the next
# ensure_backends() re-probes instead of writing into a dead backend forever.
backend_runtime_failed() {
    local backend="$1" detail="$2" var name old
    if [ "$backend" = "gsd" ]; then
        var=HAVE_GSD_KBD
        name="gsd-power"
    else
        var=HAVE_UPOWER_KBD
        name="UPower"
    fi
    old="${!var}"
    if [ "$old" = "1" ]; then
        printf -v "$var" '%s' "0"
        log_warn "$name lost (1 -> 0) after $detail; falling back (re-probe on next use)"
    fi
}

# --- D-Bus helpers --------------------------------------------------------

upower_get_raw() {
    local out
    out="$(timeout 3 gdbus call --system --dest org.freedesktop.UPower --object-path "$UP_PATH" --method "$UP_IFACE.GetBrightness" 2> /dev/null)" || return 1
    parse_first_int "$out"
}

upower_set_raw() {
    timeout 3 gdbus call --system --dest org.freedesktop.UPower --object-path "$UP_PATH" --method "$UP_IFACE.SetBrightness" "$1" > /dev/null 2>&1
}

gsd_get_pct() {
    local out
    out="$(timeout 3 gdbus call --session --dest org.gnome.SettingsDaemon.Power --object-path "$GSD_PATH" --method "$DBUS_PROPS.Get" "$GSD_IFACE" Brightness 2> /dev/null)" || return 1
    parse_first_int "$out"
}

gsd_set_pct() {
    timeout 3 gdbus call --session --dest org.gnome.SettingsDaemon.Power --object-path "$GSD_PATH" --method "$DBUS_PROPS.Set" "$GSD_IFACE" Brightness "<int32 $1>" > /dev/null 2>&1
}

get_max() {
    local m
    m="$(cat "$SYSFS_MAX" 2> /dev/null || echo "")"
    if [[ "$m" =~ ^[0-9]+$ ]] && [ "$m" -gt 0 ]; then
        echo "$m"
    else
        echo 100
    fi
}

# --- ectool fallback helpers ---------------------------------------------

ectool_get_raw() {
    local pct=""
    local max
    if command -v ectool > /dev/null 2>&1; then
        pct="$(ectool pwmgetkblight 2> /dev/null | grep -o '[0-9][0-9]*' | head -n1 || echo "")"
        if ! [[ "$pct" =~ ^[0-9]+$ ]]; then
            pct="$(sudo -n ectool pwmgetkblight 2> /dev/null | grep -o '[0-9][0-9]*' | head -n1 || echo "")"
        fi
    elif [ -x /usr/local/bin/ectool ]; then
        pct="$(/usr/local/bin/ectool pwmgetkblight 2> /dev/null | grep -o '[0-9][0-9]*' | head -n1 || echo "")"
        if ! [[ "$pct" =~ ^[0-9]+$ ]]; then
            pct="$(sudo -n /usr/local/bin/ectool pwmgetkblight 2> /dev/null | grep -o '[0-9][0-9]*' | head -n1 || echo "")"
        fi
    fi
    if [[ "$pct" =~ ^[0-9]+$ ]]; then
        max="$(get_max)"
        if ! [[ "$max" =~ ^[0-9]+$ ]] || [ "$max" -eq 0 ]; then
            max=100
        fi
        echo $((pct * max / 100))
    else
        log_warn_once "ectool-read" "ectool pwmgetkblight unavailable or failed (sudo -n attempted)"
        echo ""
    fi
}

# Returns 0 when at least one ectool invocation (direct, sudo -n, or the
# /usr/local/bin copy) accepted the write, 1 when all of them failed.
ectool_set_pct() {
    local pct="$1"
    if command -v ectool > /dev/null 2>&1; then
        if ectool pwmsetkblight "$pct" > /dev/null 2>&1; then
            return 0
        fi
        if sudo -n ectool pwmsetkblight "$pct" > /dev/null 2>&1; then
            return 0
        fi
        log_warn_once "ectool-set" "ectool pwmsetkblight $pct failed even with sudo -n"
        return 1
    elif [ -x /usr/local/bin/ectool ]; then
        if /usr/local/bin/ectool pwmsetkblight "$pct" > /dev/null 2>&1; then
            return 0
        fi
        if sudo -n /usr/local/bin/ectool pwmsetkblight "$pct" > /dev/null 2>&1; then
            return 0
        fi
        log_warn_once "ectool-local-set" "/usr/local/bin/ectool pwmsetkblight $pct failed even with sudo -n"
        return 1
    fi
    log_warn_once "ectool-missing" "no ectool available for legacy fallback"
    return 1
}

# Returns 0 only when the write is confirmed.  A readable sysfs that does not
# show the target value is NOT a success even when echo/tee returned 0: only a
# successful ectool rescue can turn that into a success.  When sysfs cannot be
# read back at all, the write syscall result is trusted.
legacy_set_brightness() {
    local val="$1"
    local max="$2"
    local pct
    pct=$((val * 100 / max))

    if [ ! -f "$SYSFS_BRIGHTNESS" ]; then
        log_warn_once "legacy-no-sysfs" "$SYSFS_BRIGHTNESS missing; using ectool only"
        ectool_set_pct "$pct" || return 1
        return 0
    fi
    local write_ok=0
    if [ -w "$SYSFS_BRIGHTNESS" ]; then
        if echo "$val" > "$SYSFS_BRIGHTNESS" 2> /dev/null; then
            write_ok=1
        else
            log_warn_once "sysfs-write" "direct write to $SYSFS_BRIGHTNESS failed"
        fi
    else
        if echo "$val" | sudo -n tee "$SYSFS_BRIGHTNESS" > /dev/null 2>&1; then
            write_ok=1
        else
            log_warn_once "sysfs-sudo" "sudo -n tee $SYSFS_BRIGHTNESS failed (user service may lack passwordless sudo)"
        fi
    fi
    local cur
    cur="$(cat "$SYSFS_BRIGHTNESS" 2> /dev/null || echo "-1")"
    if [[ "$cur" =~ ^[0-9]+$ ]]; then
        if [ "$cur" -eq "$val" ]; then
            return 0
        fi
        log_warn_once "sysfs-verify" "sysfs verify mismatch ($cur != $val); falling back to ectool"
        if ectool_set_pct "$pct"; then
            return 0
        fi
        return 1
    fi
    # No readback possible: trust the write syscall (or let ectool try).
    if [ "$write_ok" -eq 1 ]; then
        return 0
    fi
    if ectool_set_pct "$pct"; then
        return 0
    fi
    return 1
}

# --- Read / write chain ---------------------------------------------------

get_brightness() {
    local raw=""
    if [ "$C640_KBD_FORCE_LEGACY" != "1" ]; then
        ensure_backends
        if [ "$HAVE_UPOWER_KBD" = "1" ]; then
            raw="$(upower_get_raw || echo "")"
            if [[ "$raw" =~ ^[0-9]+$ ]]; then
                echo "$raw"
                return 0
            fi
            log_warn_once "upower-get" "UPower GetBrightness failed; falling back to sysfs/ectool"
            backend_runtime_failed upower "GetBrightness failure"
        fi
    fi
    if [ -f "$SYSFS_BRIGHTNESS" ]; then
        local sys
        sys="$(cat "$SYSFS_BRIGHTNESS" 2> /dev/null || echo "")"
        if [[ "$sys" =~ ^[0-9]+$ ]]; then
            echo "$sys"
            return 0
        fi
    fi
    ectool_get_raw
}

# Verify a written value through any available readback path.  This
# deliberately does NOT consult HAVE_GSD_KBD/HAVE_UPOWER_KBD: the Phase 1
# backend re-probe caches those for write routing, while a verifier may still
# be readable (or may have just disappeared) independently of that cache.
# rc 0 = at least one verifier matches, 1 = every readable verifier disagrees,
# 2 = no readback path at all.
verify_brightness() {
    local want="$1"
    local found=0
    local raw
    if [ "$C640_KBD_FORCE_LEGACY" != "1" ]; then
        raw="$(upower_get_raw 2> /dev/null || echo "")"
        if [[ "$raw" =~ ^[0-9]+$ ]]; then
            found=1
            if [ "$raw" -eq "$want" ]; then
                return 0
            fi
        fi
    fi
    if [ -f "$SYSFS_BRIGHTNESS" ]; then
        raw="$(cat "$SYSFS_BRIGHTNESS" 2> /dev/null || echo "")"
        if [[ "$raw" =~ ^[0-9]+$ ]]; then
            found=1
            if [ "$raw" -eq "$want" ]; then
                return 0
            fi
        fi
    fi
    if [ "$found" -eq 1 ]; then
        return 1
    fi
    return 2
}

# rc 0 = at least one backend accepted the write and a readback (where
# available) confirmed the target; rc 1 = invalid value, every writer failed,
# or every readback disagreed.  A write with no readback path at all is
# accepted as authoritative, but emits a WARN.
set_brightness() {
    local val="$1"
    if ! [[ "$val" =~ ^-?[0-9]+$ ]]; then
        return 1
    fi
    local max
    max="$(get_max)"
    if ! [[ "$max" =~ ^[0-9]+$ ]] || [ "$max" -eq 0 ]; then
        max=100
    fi
    if [ "$val" -lt 0 ]; then
        val=0
    fi
    if [ "$val" -gt "$max" ]; then
        val="$max"
    fi

    ensure_backends
    local vrc=0

    # 1) gsd-power property (pct) is the single writer: it updates its own
    #    cache and drives UPower -> LED.  Availability is proven by a
    #    successful Properties.Get.
    if [ "$HAVE_GSD_KBD" = "1" ]; then
        local gpct
        gpct="$(gsd_get_pct || echo "")"
        if [[ "$gpct" =~ ^[0-9]+$ ]]; then
            local pct
            pct=$((val * 100 / max))
            if gsd_set_pct "$pct"; then
                if verify_brightness "$val"; then vrc=0; else vrc=$?; fi
                case "$vrc" in
                    0) return 0 ;;
                    2)
                        log_warn_once "verify-unavailable" "gsd-power write accepted but no brightness readback available; treating as success (WARN)"
                        return 0
                        ;;
                esac
                # vrc == 1: the write did not reach the LED.  The common cause
                # is kbd_brightness_now == value short-circuit: gsd-power
                # skipped the hardware write because its cache was already at
                # pct.  Re-setting the same property would short-circuit
                # again, so force the hardware via UPower -- then VERIFY it,
                # otherwise a "gsd fake success" would be mistaken for a
                # completed restore.
                if [ "$HAVE_UPOWER_KBD" = "1" ]; then
                    log_warn "gsd cache already at pct=$pct but brightness readback mismatch (expected $val); forcing hardware via UPower"
                    if upower_set_raw "$val"; then
                        if verify_brightness "$val"; then vrc=0; else vrc=$?; fi
                        if [ "$vrc" -eq 0 ]; then
                            return 0
                        fi
                        if [ "$vrc" -eq 2 ]; then
                            log_warn_once "verify-unavailable" "UPower repair accepted but no brightness readback available; treating as success (WARN)"
                            return 0
                        fi
                        log_warn "UPower repair for $val did not verify; continuing fallback"
                    else
                        log_warn "UPower SetBrightness $val failed during gsd-power repair"
                    fi
                fi
                # Fall through to the direct UPower / legacy writers.
            else
                log_warn_once "gsd-set" "gsd-power Properties.Set failed; trying UPower directly"
                backend_runtime_failed gsd "Properties.Set failure"
            fi
        else
            log_warn_once "gsd-get" "gsd-power Brightness Properties.Get failed; trying UPower directly"
            backend_runtime_failed gsd "Properties.Get failure"
        fi
    fi

    # 2) Direct UPower write.  gsd-power ignores UPower "external" signals,
    #    so its cache may stay out of sync -> warn once.  The write itself is
    #    not enough: read it back before declaring success.
    if [ "$HAVE_UPOWER_KBD" = "1" ]; then
        if upower_set_raw "$val"; then
            log_warn_once "upower-direct" "wrote UPower directly (raw=$val); gsd-power cache may be out of sync"
            if verify_brightness "$val"; then vrc=0; else vrc=$?; fi
            case "$vrc" in
                0) return 0 ;;
                2)
                    log_warn_once "verify-unavailable" "UPower write accepted but no brightness readback available; treating as success (WARN)"
                    return 0
                    ;;
            esac
            log_warn "UPower SetBrightness $val succeeded but readback mismatch; trying legacy fallback"
        else
            log_warn_once "upower-set" "UPower SetBrightness $val failed; falling back to legacy path"
            backend_runtime_failed upower "SetBrightness failure"
        fi
    fi

    # 3) Legacy sysfs / sudo tee / ectool fallback.  It performs its own
    #    readback for sysfs; ectool has no readback path and is authoritative
    #    when its set command succeeds.
    if [ "$HAVE_GSD_KBD" != "1" ] && [ "$HAVE_UPOWER_KBD" != "1" ]; then
        log_warn_once "no-dbus-backend" "gsd-power and UPower keyboard backends unavailable; using legacy sysfs/ectool path"
    fi
    legacy_set_brightness "$val" "$max" || return 1
    return 0
}

# --- ScreenSaver state helpers -------------------------------------------

# Tristate ScreenSaver probe.  Only an explicit "true"/"false" reply is
# trusted.  A missing tool, a timeout, a missing service or an unrecognisable
# reply is "unknown" -- it must NOT be read as "false" on a restore path.
# Every gdbus/busctl call is bounded by `timeout 3`.
screensaver_tristate() {
    local out
    if command -v gdbus > /dev/null 2>&1; then
        out="$(timeout 3 gdbus call --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver --method org.gnome.ScreenSaver.GetActive 2> /dev/null || true)"
        if grep -qw "true" <<< "$out"; then
            echo "active"
            return 0
        fi
        if grep -qw "false" <<< "$out"; then
            echo "inactive"
            return 0
        fi
        out="$(timeout 3 gdbus call --session --dest org.freedesktop.ScreenSaver --object-path /org/freedesktop/ScreenSaver --method org.freedesktop.ScreenSaver.GetActive 2> /dev/null || true)"
        if grep -qw "true" <<< "$out"; then
            echo "active"
            return 0
        fi
        if grep -qw "false" <<< "$out"; then
            echo "inactive"
            return 0
        fi
        echo "unknown"
        return 0
    fi
    if command -v busctl > /dev/null 2>&1; then
        out="$(timeout 3 busctl --user get-property org.gnome.ScreenSaver /org/gnome/ScreenSaver org.gnome.ScreenSaver Active 2> /dev/null || true)"
        if grep -qw "true" <<< "$out"; then
            echo "active"
            return 0
        fi
        if grep -qw "false" <<< "$out"; then
            echo "inactive"
            return 0
        fi
        out="$(timeout 3 busctl --user get-property org.freedesktop.ScreenSaver /org/freedesktop/ScreenSaver org.freedesktop.ScreenSaver Active 2> /dev/null || true)"
        if grep -qw "true" <<< "$out"; then
            echo "active"
            return 0
        fi
        if grep -qw "false" <<< "$out"; then
            echo "inactive"
            return 0
        fi
        echo "unknown"
        return 0
    fi
    echo "unknown"
}

# Backwards-compatible boolean wrapper for NON-writing callers only (the
# sampler and guard_blank).  There a fail-open answer merely skips a sample or
# a forced-off guard; it never writes a restored brightness.  Restore paths
# must call screensaver_tristate() and fail closed instead.
screensaver_is_active() {
    if [ "$(screensaver_tristate)" = "active" ]; then
        echo "true"
    else
        echo "false"
    fi
}

read_last_user_brightness() {
    local v
    v="$(cat "$LAST_USER_FILE" 2> /dev/null || echo "")"
    # 0 is a legitimate recorded value: the user deliberately switched the
    # backlight off while the screen was on. It must reach save_state so a
    # later blank does not restore an old non-zero brightness.
    if [[ "$v" =~ ^[0-9]+$ ]]; then
        printf '%s' "$v"
    fi
}

# Atomically persist both the last-user value and its metadata.  The value
# file's format is unchanged (a bare number); the sidecar records the source
# and a timestamp so save_state can tell an explicit manual off from a stale
# sampler reading.  Failures are non-fatal: the cache is best-effort.
write_last_user() {
    local v="$1" src="$2"
    local meta="${LAST_USER_META_FILE:-$LAST_USER_FILE.meta}"
    local tmp ts

    tmp="$(mktemp "$STATE_DIR/.c640-kbd-lu-XXXXXX" 2> /dev/null || mktemp "${TMPDIR:-/tmp}/.c640-kbd-lu-XXXXXX" 2> /dev/null || echo "")"
    if [ -n "$tmp" ]; then
        printf '%s\n' "$v" > "$tmp" 2> /dev/null || true
        chmod 600 "$tmp" 2> /dev/null || true
        mv -f "$tmp" "$LAST_USER_FILE" 2> /dev/null || cp "$tmp" "$LAST_USER_FILE" 2> /dev/null || true
        rm -f "$tmp" 2> /dev/null || true
    fi

    ts="$(date +%s 2> /dev/null || echo 0)"
    tmp="$(mktemp "$STATE_DIR/.c640-kbd-lum-XXXXXX" 2> /dev/null || mktemp "${TMPDIR:-/tmp}/.c640-kbd-lum-XXXXXX" 2> /dev/null || echo "")"
    if [ -n "$tmp" ]; then
        {
            printf 'source=%s\n' "$src"
            printf 'ts=%s\n' "$ts"
        } > "$tmp" 2> /dev/null || true
        chmod 600 "$tmp" 2> /dev/null || true
        mv -f "$tmp" "$meta" 2> /dev/null || cp "$tmp" "$meta" 2> /dev/null || true
        rm -f "$tmp" 2> /dev/null || true
    fi
}

# Source recorded in LAST_USER_META_FILE ("nonzero" or "manual0"), empty when
# the sidecar is missing or malformed (e.g. a cache left by an older daemon).
last_user_cache_source() {
    local meta="${LAST_USER_META_FILE:-$LAST_USER_FILE.meta}"
    local line src=""
    while IFS= read -r line; do
        case "$line" in
            source=*) src="${line#source=}" ;;
        esac
    done <<< "$(cat "$meta" 2> /dev/null || true)"
    printf '%s' "$src"
}

# Age of the cached value in seconds.  Prefer the sidecar's ts; fall back to
# LAST_USER_FILE's mtime when ts is absent (older cache / manual file write).
last_user_cache_age() {
    local meta="${LAST_USER_META_FILE:-$LAST_USER_FILE.meta}"
    local line ts="" now mtime
    while IFS= read -r line; do
        case "$line" in
            ts=*) ts="${line#ts=}" ;;
        esac
    done <<< "$(cat "$meta" 2> /dev/null || true)"
    now="$(date +%s 2> /dev/null || echo 0)"
    if [[ "$ts" =~ ^[0-9]+$ ]]; then
        printf '%s' "$((now - ts))"
    elif [ -f "$LAST_USER_FILE" ]; then
        mtime="$(stat -c %Y "$LAST_USER_FILE" 2> /dev/null || echo "")"
        if [[ "$mtime" =~ ^[0-9]+$ ]]; then
            printf '%s' "$((now - mtime))"
        fi
    fi
}

# One sampler tick, kept separate from the infinite loop so it is unit
# testable. Only observations made while the screen is ON count as user
# intent; a blank-side transient 0 is ignored.
sample_brightness_once() {
    # Convergence path for systems without a working dbus-monitor: a stray
    # resume flag left by the sleep hook is picked up by the sampler too.
    # handle_resume serialises itself with RESUME_LOCK, so racing with the
    # login1 monitor cannot issue two writes.
    if [ -f "$HANDOFF_RESUME_FILE" ]; then
        # A DEFER (rc=2) keeps the flag for the next 5s tick; it is not a
        # sampler failure.  `|| true` is required under set -e.
        handle_resume || true
    fi
    if [ "$(screensaver_is_active)" = "true" ]; then
        _C640_ZERO_STREAK=0
        return 0
    fi
    local b pct
    b="$(get_brightness)"
    if [[ "$b" =~ ^[0-9]+$ ]] && [ "$b" -ne 0 ]; then
        _C640_ZERO_STREAK=0
        last_user_brightness="$b"
        write_last_user "$b" nonzero
        return 0
    fi
    if [[ "$b" =~ ^[0-9]+$ ]] && [ "$b" -eq 0 ]; then
        pct="$(gsd_get_pct 2> /dev/null || echo "")"
        # A non-zero gsd percentage means gsd still considers the light on;
        # the zero is a transient/hardware artefact, not user intent.
        if [[ "$pct" =~ ^[0-9]+$ ]] && [ "$pct" -ne 0 ]; then
            _C640_ZERO_STREAK=0
            return 0
        fi
        _C640_ZERO_STREAK=$((_C640_ZERO_STREAK + 1))
        if [ "$_C640_ZERO_STREAK" -ge 2 ]; then
            last_user_brightness=0
            write_last_user 0 manual0
            log "sampler: two consecutive on-screen zeros (gsd pct=0) -> recording explicit off"
        fi
    fi
}

brightness_sampler_loop() {
    log "brightness sampler started (interval 5s)"
    _C640_ZERO_STREAK=0
    while true; do
        sample_brightness_once
        sleep 5
    done
}

# A LAST_USER_FILE left behind by a previous daemon run is stale. Re-seed it
# from the brightness the user currently sees so the first blank after a
# restart saves the real value (including 0) instead of an old one.
seed_last_user_from_current() {
    if [ "$(screensaver_is_active)" = "true" ]; then
        return 0
    fi
    local cur
    cur="$(get_brightness)"
    if [[ "$cur" =~ ^[0-9]+$ ]]; then
        last_user_brightness="$cur"
        # A restart seed normally records what the user currently sees.  When
        # the light is already off, record it as an explicit off so a later
        # blank with a non-zero firmware residue cannot re-light the keyboard
        # before the sampler has observed a fresh manual off (~5-10s).
        if [ "$cur" -eq 0 ]; then
            write_last_user "$cur" manual0
        else
            write_last_user "$cur" nonzero
        fi
    fi
}

# --- State save / restore -------------------------------------------------

save_state() {
    # Atomic first-wins with flock on STATE_LOCK.  A current valid non-zero
    # reading wins: the sampler only runs every 5s, so a brightness change
    # made just before a blank must not be lost to a stale cache.  The cache
    # is used for blank-side zeros (firmware already off) and unreadable
    # hardware.  An explicit manual off stays in force only while it is fresh
    # and gsd-power still reports off; once gsd reports non-zero the user has
    # brightened again and the live reading is authoritative.
    (
        flock -n 200 || return 0
        if [ -f "$STATE_FILE" ]; then
            return 0
        fi
        local live cache curr src age pct
        # get_brightness() runs in a command substitution (its own subshell),
        # so its backend probe would not be visible here.  Probe once in this
        # shell so HAVE_GSD_KBD is accurate for the gsd pct check below.
        ensure_backends
        live="$(get_brightness 2> /dev/null || echo "")"
        cache="$(read_last_user_brightness)"
        src="$(last_user_cache_source)"
        curr=""
        if [[ "$live" =~ ^[0-9]+$ ]] && [ "$live" -ne 0 ]; then
            if [ "$cache" = "0" ] && [ "$src" = "manual0" ]; then
                age="$(last_user_cache_age)"
                if [[ "$age" =~ ^[0-9]+$ ]] && [ "$age" -le "$C640_KBD_LAST_USER_TTL" ]; then
                    pct=""
                    # gsd_get_pct failure/timeout means "empty", not 0, and is
                    # only queried when a gsd keyboard backend is present.
                    if [ "$HAVE_GSD_KBD" = "1" ]; then
                        pct="$(gsd_get_pct 2> /dev/null || echo "")"
                    fi
                    if [ -z "$pct" ] || [ "$pct" = "0" ]; then
                        curr=0
                    fi
                fi
            fi
            if [ -z "$curr" ] && [ -n "$cache" ] && [ -z "$src" ]; then
                # A cache without metadata has no provenance (older daemon or
                # a direct file write, e.g. a blank simulated mid-restore):
                # retain the historical cache-wins behaviour for it.
                curr="$cache"
            fi
            if [ -z "$curr" ]; then
                curr="$live"
            fi
        elif [ "$live" = "0" ]; then
            # Blank-side zero: the firmware already turned the LED off, so the
            # live reading carries no user intent.  Use the cache regardless
            # of age; an old value still beats a dark keyboard on unblank.
            if [ -n "$cache" ]; then
                curr="$cache"
            else
                curr=0
            fi
        else
            # Unreadable hardware: use the cache when available.
            curr="$cache"
        fi
        # Final fallbacks when the live reading and the cache were unusable.
        if [ -z "$curr" ]; then
            curr="$last_user_brightness"
        fi
        if [ -z "$curr" ]; then
            curr="$(get_brightness 2> /dev/null || echo "")"
        fi
        if ! [[ "$curr" =~ ^[0-9]+$ ]]; then
            return 0
        fi
        mkdir -p "$(dirname "$STATE_FILE")" 2> /dev/null || true
        local tmp
        tmp="$(mktemp "$STATE_DIR/.c640-kbd-XXXXXX" 2> /dev/null || mktemp "${TMPDIR:-/tmp}/.c640-kbd-XXXXXX")"
        echo "$curr" > "$tmp" 2> /dev/null || true
        chmod 600 "$tmp" 2> /dev/null || true
        mv -f "$tmp" "$STATE_FILE" 2> /dev/null || cp "$tmp" "$STATE_FILE" 2> /dev/null || true
        rm -f "$tmp" 2> /dev/null || true
        log "saved brightness $curr"
    ) 200> "$STATE_LOCK" || true
}

bump_restore_gen() {
    local g
    g="$(cat "$RESTORE_GEN_FILE" 2> /dev/null || echo 0)"
    if ! [[ "$g" =~ ^[0-9]+$ ]]; then
        g=0
    fi
    restore_gen=$((g + 1))
    printf '%s\n' "$restore_gen" > "$RESTORE_GEN_FILE" 2> /dev/null || true
}

# Crash recovery for the staging window: the value in PENDING is a restore
# that never reached finalize_restore().  If a new STATE_FILE exists it is
# newer (a blank saved it) and wins; otherwise the staged value is moved back
# so the next unblank can retry it.  Always returns 0 (safe to call in main).
recover_pending_state() {
    if [ ! -f "$RESTORE_PENDING_FILE" ]; then
        return 0
    fi
    if ! exec 204> "$STATE_LOCK"; then
        return 0
    fi
    if ! flock -n 204; then
        exec 204>&-
        return 0
    fi
    if [ -f "$STATE_FILE" ]; then
        rm -f "$RESTORE_PENDING_FILE" 2> /dev/null || true
        log "discarding interrupted restore (newer state already saved)"
    else
        if mv -f "$RESTORE_PENDING_FILE" "$STATE_FILE" 2> /dev/null; then
            log "recovered interrupted restore from $RESTORE_PENDING_FILE"
        else
            log_warn "cannot recover $RESTORE_PENDING_FILE to $STATE_FILE"
        fi
    fi
    flock -u 204
    exec 204>&-
    return 0
}

# Shared tail of every restore attempt.  PENDING is consumed only after the
# write succeeded; on failure it is rolled back to STATE_FILE (unless a newer
# blank already saved a replacement).  Returns the write's rc so the caller
# can report failure and re-arm retries.
#
# The state lock is taken with a bounded wait (flock -w 1) here.  Every holder
# is a short critical section (save_state, a stage step, a retry's stage) and
# the slow brightness write is already finished before finalize runs, so one
# second is enough; on timeout we fall through to the degraded path below and
# resolve PENDING anyway, so the staged value can never be orphaned.  A purely
# non-blocking flock used to bail out on transient contention while PENDING
# held the only copy of the saved value: STATE_FILE was already staged away,
# so the PENDING guard made every later restore_state/cleanup skip forever
# until a daemon restart.  If flock (or the open) still fails, resolve PENDING
# anyway so it can never be orphaned.
finalize_restore() {
    local saved="$1" rc="$2" gen="$3"
    local have_lock=1
    if exec 203> "$STATE_LOCK"; then
        # PENDING holds the only copy of the staged value, so wait briefly for
        # a short holder instead of bailing out immediately.  The degraded
        # path below is unchanged when the bounded wait still fails.
        if ! flock -w 1 203; then
            log_warn "restore finalize (gen=$gen): flock failed; resolving PENDING without the lock"
            have_lock=0
        fi
    else
        log_warn "cannot open state lock $STATE_LOCK in finalize_restore; resolving PENDING without the lock"
        have_lock=0
    fi
    local newer=""
    if [ -f "$STATE_FILE" ]; then
        newer="$(cat "$STATE_FILE" 2> /dev/null || echo "")"
    fi
    if [ "$rc" -eq 0 ]; then
        rm -f "$RESTORE_PENDING_FILE" 2> /dev/null || true
        if [ -n "$newer" ] && [ "$newer" != "$saved" ]; then
            log "restore (gen=$gen) succeeded; keeping newer blank-time state $newer"
        fi
    else
        if [ -z "$newer" ]; then
            if ! mv -f "$RESTORE_PENDING_FILE" "$STATE_FILE" 2> /dev/null; then
                log_warn "restore failed (gen=$gen): could not roll staged value $saved back to $STATE_FILE"
            fi
        else
            rm -f "$RESTORE_PENDING_FILE" 2> /dev/null || true
            log "restore failed (gen=$gen): keeping newer blank-time state $newer"
        fi
        log_warn "restore failed (gen=$gen, rc=$rc): keeping brightness $saved for retry"
    fi
    if [ "$have_lock" -eq 1 ]; then
        flock -u 203
    fi
    exec 203>&-
    return "$rc"
}

# A zero rc from set_brightness + finalize_restore is NOT proof that the
# restore completed: finalize may have failed to consume STATE/PENDING (e.g. a
# blank saved a replacement value), or the LED may never have changed.  Read
# brightness outside the lock so a slow D-Bus query cannot starve save_state;
# the STATE/PENDING check is then done under a short STATE_LOCK critical section.
verify_restore_applied() {
    local saved="$1" gen="$2"
    local cur
    cur="$(get_brightness 2> /dev/null || echo "")"
    if ! exec 208> "$STATE_LOCK"; then
        log_warn "restore verify (gen=$gen): cannot open state lock $STATE_LOCK"
        return "$RC_DEFER"
    fi
    if ! flock -n 208; then
        exec 208>&-
        log "restore verify (gen=$gen): state lock busy; not completed"
        return "$RC_DEFER"
    fi
    local rc="$RC_DONE"
    if [ -f "$RESTORE_PENDING_FILE" ] || [ -f "$STATE_FILE" ]; then
        log_warn "restore verify (gen=$gen): rc=0 but STATE/PENDING still exists; not completed"
        rc="$RC_DEFER"
    elif [[ "$cur" =~ ^[0-9]+$ ]] && [ "$((10#$cur))" -ne "$((10#$saved))" ]; then
        log_warn "restore verify (gen=$gen): brightness readback $cur != $saved; not completed"
        rc="$RC_FAIL"
        # Do NOT re-seed STATE_FILE here: the mismatch may be a deliberate
        # user brightness change made after the restore write.
        # Known limitation: set_brightness() can report success via vrc=2
        # ("no readback path; trust the write") on the legacy/ectool path,
        # while this get_brightness() can still read a DIFFERENT backend
        # (ectool or a stale sysfs value).  That cross-backend mismatch is
        # reported as FAIL even though the write may have succeeded and the
        # staged state is already consumed.  Re-seeding would overwrite a
        # genuine user change, so it is deliberately not done; a later
        # unblank can still save/restore from the last-user cache.
    fi
    flock -u 208 2> /dev/null || true
    exec 208>&-
    return "$rc"
}

schedule_restore_retries() {
    local gen="$1"
    shift
    local delay
    for delay in "$@"; do
        (
            sleep "$delay"
            local cur_gen
            cur_gen="$(cat "$RESTORE_GEN_FILE" 2> /dev/null || echo 0)"
            if [ "$cur_gen" != "$gen" ]; then
                log_debug "restore retry +${delay}s gen=$gen superseded by $cur_gen"
                exit 0
            fi
            # Recovery is startup-only: a PENDING that still exists here can
            # only belong to a restore that is mid-write, so never adopt it.
            if [ ! -f "$STATE_FILE" ]; then
                exit 0
            fi
            # Fail closed: only an explicit "inactive" permits a restore
            # write.  "active" and "unknown" both defer to a later unblank.
            if [ "$(screensaver_tristate)" != "inactive" ]; then
                exit 0
            fi
            if ! exec 202> "$STATE_LOCK"; then
                exit 0
            fi
            if ! flock -n 202; then
                exec 202>&-
                exit 0
            fi
            # Re-check the generation while holding the lock, so a restore
            # that started after this retry was scheduled cannot be undone.
            cur_gen="$(cat "$RESTORE_GEN_FILE" 2> /dev/null || echo 0)"
            if [ "$cur_gen" != "$gen" ]; then
                flock -u 202
                exec 202>&-
                exit 0
            fi
            local saved
            saved="$(cat "$STATE_FILE" 2> /dev/null || echo "")"
            if ! [[ "$saved" =~ ^[0-9]+$ ]]; then
                rm -f "$STATE_FILE" 2> /dev/null || true
                flock -u 202
                exec 202>&-
                exit 0
            fi
            # Stage before writing, exactly like the initial restore: a blank
            # during the write can still save a newer value to STATE_FILE.
            if ! mv -f "$STATE_FILE" "$RESTORE_PENDING_FILE" 2> /dev/null; then
                flock -u 202
                exec 202>&-
                exit 0
            fi
            flock -u 202
            exec 202>&-
            log "restore retry +${delay}s (gen=$gen): restoring brightness $saved"
            local rc=0
            if set_brightness "$saved"; then rc=0; else rc=$?; fi
            # No recursive re-schedule: a failing backend would otherwise
            # create a retry storm.  The state file is left in place for the
            # next unblank event.
            finalize_restore "$saved" "$rc" "$gen" || true
            exit 0
        ) &
    done
}

restore_state() {
    # Normal callers never pass an argument: the ScreenSaver check below is
    # fail-closed for every restore path.  The ONLY bypass is the explicit
    # C640_KBD_RESUME_ALLOW_UNKNOWN=1 resume opt-in (force=1), which must also
    # set that env var -- a stray `restore_state 1` cannot open the bypass.
    local force="${1:-0}"
    if ! exec 201> "$STATE_LOCK"; then
        log_warn "cannot open state lock $STATE_LOCK"
        return "$RC_DEFER"
    fi
    if ! flock -n 201; then
        exec 201>&-
        log "restore deferred: state lock busy; keeping state for retry"
        return "$RC_DEFER"
    fi

    # PENDING is the marker for a restore between stage and finalize.  Such a
    # restore has released STATE_LOCK for the slow D-Bus write, so a second
    # monitor source can reach this point while its value is staged.  Leave
    # that value (and the generation) alone: its own finalize, or the daemon
    # restart, owns it.  Crash recovery therefore runs only in main().
    if [ -f "$RESTORE_PENDING_FILE" ]; then
        log "restore skipped: another restore is in progress (staged value pending)"
        flock -u 201
        exec 201>&-
        return "$RC_DEFER"
    fi

    # Bump the generation only after owning the lock: two concurrent restores
    # can no longer stamp the file with the same generation and let a stale
    # scheduled retry through.
    bump_restore_gen
    local gen="$restore_gen"

    local saved
    saved="$(cat "$STATE_FILE" 2> /dev/null || echo "")"
    if ! [[ "$saved" =~ ^[0-9]+$ ]]; then
        log_warn "discarding invalid saved brightness '$saved'"
        rm -f "$STATE_FILE" "$RESTORE_PENDING_FILE" 2> /dev/null || true
        flock -u 201
        exec 201>&-
        # Nothing usable to restore: a safe no-op, so the caller may consume
        # its resume flag (DONE), unlike a deferral or a failure.
        return "$RC_DONE"
    fi

    # Defer while the screen is still active (re-blank race, TROUBLESHOOTING
    # §11), but converge via +0.5s/+1.5s/+3s retries.  Old retries are
    # invalidated by the generation counter; keeping the state makes the
    # retries meaningful (and lets a later unblank restore it too).
    local ss
    ss="$(screensaver_tristate)"
    if [ "$ss" != "inactive" ] && ! { [ "$force" = "1" ] && [ "$C640_KBD_RESUME_ALLOW_UNKNOWN" = "1" ]; }; then
        log "restore deferred: ScreenSaver $ss (gen=$gen); only inactive permits a write"
        flock -u 201
        exec 201>&-
        schedule_restore_retries "$gen" 0.5 1.5 3
        return "$RC_DEFER"
    fi
    if [ "$ss" != "inactive" ]; then
        log_warn "restore: explicit C640_KBD_RESUME_ALLOW_UNKNOWN=1 overrides ScreenSaver=$ss"
    fi

    # A valid 0 goes through the exact same write path as any other value:
    # "0" means the user explicitly switched the light off and MUST be
    # written, otherwise a non-zero residual brightness survives the restore.
    # Stage the value to PENDING so a blank arriving during the write can
    # still save_state() its new value into STATE_FILE.
    if ! mv -f "$STATE_FILE" "$RESTORE_PENDING_FILE" 2> /dev/null; then
        log_warn "cannot stage saved brightness $saved; keeping $STATE_FILE"
        flock -u 201
        exec 201>&-
        return "$RC_FAIL"
    fi
    log "restoring brightness $saved"
    # Release the state lock BEFORE the D-Bus write. set_brightness can block
    # for several seconds (gdbus timeouts); a blank arriving in that window
    # must still be able to save_state() the new value with flock -n.
    flock -u 201
    exec 201>&-

    local rc=0
    if set_brightness "$saved"; then rc=0; else rc=$?; fi
    if finalize_restore "$saved" "$rc" "$gen"; then :; else rc=$?; fi

    if [ "$rc" -ne 0 ]; then
        # Re-arm the same generation once; retries themselves do not recurse.
        schedule_restore_retries "$gen" 0.5 1.5 3
        return "$RC_FAIL"
    fi
    # A zero write rc alone does not mean the restore completed (e.g. a blank
    # saved a new STATE_FILE while the write was in flight).
    if verify_restore_applied "$saved" "$gen"; then :; else rc=$?; fi
    if [ "$rc" -eq "$RC_DEFER" ]; then
        schedule_restore_retries "$gen" 0.5 1.5 3
    fi
    return "$rc"
}

# --- Phase 4b: resume handoff ---------------------------------------------

# Body of adopt_suspend_handoff(), called with STATE_LOCK held.  No brightness
# write: publishing the value into STATE_FILE is all this does.  The hook
# never deletes the handoff; consuming it here (only after a successful
# adoption) is what stops a later cycle reusing a stale value.
_adopt_suspend_handoff_locked() {
    # A staged restore owns STATE_FILE until its finalize; do not overwrite it.
    # Return a distinct "deferred" code (2): the caller must NOT treat the
    # missing STATE_FILE as "no saved state" and clear the resume flag while
    # the staged restore is still in flight (P2-1).  The handoff is kept and
    # the sampler/startup handler will adopt it once PENDING disappears.
    if [ -f "$RESTORE_PENDING_FILE" ]; then
        log "suspend handoff adoption deferred: restore in progress (staged value pending)"
        return 2
    fi
    local raw val existing tmp
    # Command substitution strips the hook's trailing newline; validate what
    # remains strictly.  A bare "0" is a real value, not "no state".
    raw="$(cat "$HANDOFF_SUSPEND_FILE" 2> /dev/null || echo "")"
    raw="${raw%$'\n'}"
    if ! [[ "$raw" =~ ^[0-9]+$ ]]; then
        # The sampler calls handle_resume every 5s in a subshell; the
        # file-backed log_warn_once keeps a stale invalid handoff from
        # flooding the journal (an in-process array cannot do this).
        log_warn_once "suspend-handoff-invalid" "suspend handoff invalid ('$raw'); daemon state left unchanged"
        return 1
    fi
    val=$((10#$raw))
    existing="$(cat "$STATE_FILE" 2> /dev/null || echo "")"
    # Branch A (screen already blank at suspend time): the hook reads the LED,
    # which is 0 because the screen blank turned it off.  That 0 is a hardware
    # reading, NOT user intent, while STATE_FILE holds the last user-visible
    # brightness.  Never let the blank-side 0 overwrite a valid non-zero saved
    # value: the next unlock must restore the user's brightness, not 0.  The
    # handoff is still consumed so a later cycle cannot re-adopt this stale 0.
    # The RC_DONE here means "handoff consumed AND a valid STATE_FILE remains"
    # for the following restore -- it does NOT mean a brightness was written.
    # All other cases are unchanged: 0 with no/absent/invalid saved state is
    # adopted (a real "user switched it off"), and a non-zero handoff wins.
    if [ "$val" -eq 0 ] && [ -f "$STATE_FILE" ] && [[ "$existing" =~ ^[0-9]+$ ]] && [ "$((10#$existing))" -ne 0 ]; then
        log "ignoring blank-side suspend handoff 0; keeping saved user brightness $((10#$existing))"
        rm -f "$HANDOFF_SUSPEND_FILE" 2> /dev/null || true
        return 0
    fi
    if [ -n "$existing" ] && [ "$existing" != "$val" ]; then
        log "suspend handoff $val overrides differing daemon state $existing"
    fi
    mkdir -p "$(dirname "$STATE_FILE")" 2> /dev/null || true
    tmp="$(mktemp "$STATE_DIR/.c640-kbd-XXXXXX" 2> /dev/null || mktemp "${TMPDIR:-/tmp}/.c640-kbd-XXXXXX" 2> /dev/null || echo "")"
    if [ -z "$tmp" ]; then
        log_warn "cannot create temp file for suspend handoff adoption"
        return 1
    fi
    if ! printf '%s\n' "$val" > "$tmp" 2> /dev/null; then
        rm -f "$tmp" 2> /dev/null || true
        log_warn "cannot write suspend handoff value to temp file"
        return 1
    fi
    chmod 600 "$tmp" 2> /dev/null || true
    if ! mv -f "$tmp" "$STATE_FILE" 2> /dev/null; then
        cp "$tmp" "$STATE_FILE" 2> /dev/null || true
    fi
    rm -f "$tmp" 2> /dev/null || true
    if [ "$(cat "$STATE_FILE" 2> /dev/null || echo "")" != "$val" ]; then
        log_warn "could not publish adopted brightness $val to $STATE_FILE"
        return 1
    fi
    log "adopted suspend handoff brightness $val"
    # Only the daemon consumes the handoff, and only after the value is ours.
    rm -f "$HANDOFF_SUSPEND_FILE" 2> /dev/null || true
    return 0
}

adopt_suspend_handoff() {
    if [ ! -f "$HANDOFF_SUSPEND_FILE" ]; then
        log_warn "suspend handoff $HANDOFF_SUSPEND_FILE missing; nothing to adopt"
        # Neutral: the caller simply restores from a valid STATE_FILE if any.
        return "$RC_DONE"
    fi
    (
        local arc=0
        if ! exec 205> "$STATE_LOCK"; then
            log_warn "cannot open state lock in adopt_suspend_handoff"
            exit "$RC_DEFER"
        fi
        if ! flock -n 205; then
            exec 205>&-
            log "suspend handoff adoption deferred: state lock busy"
            exit "$RC_DEFER"
        fi
        # Propagate the locked body's rc: 2 (deferred while a staged restore
        # owns STATE_FILE) and 1 (invalid handoff / I/O failure) both mean the
        # resume flag and the handoff must be kept.  Anything outside the
        # contract is treated as a failure, never as success.
        _adopt_suspend_handoff_locked || arc=$?
        # Release explicitly: the stub flock keys on the open fd and a real
        # flock would release on fd close, but leaving a lock file behind would
        # make the immediately following restore_state() skip its write.
        flock -u 205 2> /dev/null || true
        exec 205>&-
        case "$arc" in
            0 | 1 | 2) exit "$arc" ;;
            *) exit "$RC_FAIL" ;;
        esac
    )
}

# Map restore_state()'s result to the resume contract.  Only RC_DONE consumes
# the resume flag; RC_DEFER and RC_FAIL keep it (and the saved state) for retry.
_finish_resume_restore() {
    local rc="$1"
    case "$rc" in
        "$RC_DONE")
            rm -f "$HANDOFF_RESUME_FILE" 2> /dev/null || true
            log "resume: restore complete; resume flag consumed"
            return "$RC_DONE"
            ;;
        "$RC_DEFER")
            log "resume: restore deferred (rc=$rc); keeping resume flag and state for retry"
            return "$RC_DEFER"
            ;;
        *)
            log_warn "resume: restore failed (rc=$rc); keeping resume flag; state may already be consumed — captured value retained only in last-user cache"
            return "$RC_FAIL"
            ;;
    esac
}

# The only implementation of "restore after thaw".  RESUME_LOCK makes the
# login1 monitor, the 5s sampler and the startup handler mutually exclusive,
# so gsd Properties.Set is issued at most once per resume cycle.  ALL writes
# go through restore_state() -> set_brightness(); this function never writes
# sysfs/ectool directly.
_handle_resume_locked() {
    # Thaw invalidates any D-Bus cache taken before suspend: drop it and
    # re-probe (Phase 1 semantics; FORCE_LEGACY still short-circuits in
    # ensure_backends).  A stale HAVE_*=1 must not write into a dead backend.
    HAVE_GSD_KBD=""
    HAVE_UPOWER_KBD=""
    ensure_backends

    local adopt_rc=0
    adopt_suspend_handoff || adopt_rc=$?
    case "$adopt_rc" in
        "$RC_DEFER")
            # P2-1: adoption was deferred (a staged restore owns STATE_FILE, or
            # the lock was busy).  Do NOT clear the resume flag, do NOT adopt
            # again and do NOT restore: another writer still owns this cycle.
            # The sampler/startup handler retries when the lock/PENDING clears.
            log "resume: handoff adoption deferred (restore in flight); keeping flag and handoff"
            return "$RC_DEFER"
            ;;
        "$RC_FAIL")
            log_warn "resume: handoff adoption failed (rc=$adopt_rc); keeping flag and handoff"
            return "$RC_FAIL"
            ;;
        0) ;;
        *)
            log_warn "resume: unexpected handoff adoption rc=$adopt_rc; keeping flag and handoff"
            return "$RC_FAIL"
            ;;
    esac

    if [ ! -f "$HANDOFF_RESUME_FILE" ]; then
        log_debug "resume: no resume flag present; continuing from saved state"
    fi

    local saved
    saved="$(cat "$STATE_FILE" 2> /dev/null || echo "")"
    if ! [[ "$saved" =~ ^[0-9]+$ ]]; then
        # Nothing to restore: LED_CORE_SUSPENDRESUME normally kept the value.
        rm -f "$HANDOFF_RESUME_FILE" 2> /dev/null || true
        log "resume: no saved state; clearing resume flag (kernel likely preserved brightness)"
        return "$RC_DONE"
    fi
    saved=$((10#$saved))

    # Poll for an explicit answer.  Only "inactive" is a write permit;
    # "active" and "unknown" both defer.  Total budget ~6s, capped by
    # C640_KBD_RESUME_PROBE_MAX (0 makes "unknown" converge immediately).
    local ss="unknown"
    local -a delays=(0.2 0.4 0.8 1.6 3.2)
    local i d next elapsed=0 probe_max="$C640_KBD_RESUME_PROBE_MAX"
    case "$probe_max" in
        '' | *[!0-9.]*) probe_max=10 ;;
    esac
    for i in 0 1 2 3 4 5; do
        ss="$(screensaver_tristate)"
        if [ "$ss" != "unknown" ]; then
            break
        fi
        if [ "$i" -eq 5 ]; then
            break
        fi
        d="${delays[$i]}"
        next="$(awk -v a="$elapsed" -v b="$d" 'BEGIN { printf "%.1f", a+b }')"
        if ! awk -v t="$next" -v m="$probe_max" 'BEGIN { exit !(t <= m) }'; then
            break
        fi
        sleep "$d"
        elapsed="$next"
    done
    log "resume: ScreenSaver=$ss after ${elapsed}s (saved=$saved)"

    local rc cur
    case "$ss" in
        active)
            log "resume deferred: ScreenSaver still active (saved=$saved)"
            bump_restore_gen
            schedule_restore_retries "$restore_gen" 0.5 1.5 3
            return "$RC_DEFER"
            ;;
        inactive)
            rc=0
            if restore_state; then rc=0; else rc=$?; fi
            local frc=0
            _finish_resume_restore "$rc" || frc=$?
            return "$frc"
            ;;
        unknown)
            cur="$(get_brightness 2> /dev/null || echo "")"
            # P2-2: re-read + compare + consume must be one STATE_LOCK critical
            # section.  Without the lock a blank arriving between the probe and
            # `rm` could save a newer STATE_FILE that we then delete; re-reading
            # under the lock also protects against a non-cooperative writer.
            if ! exec 207> "$STATE_LOCK"; then
                log_warn "resume: cannot open state lock for convergence check; keeping state"
                return "$RC_DEFER"
            fi
            if ! flock -n 207; then
                exec 207>&-
                log "resume: state lock busy during convergence check; keeping state"
                return "$RC_DEFER"
            fi
            local latest=""
            latest="$(cat "$STATE_FILE" 2> /dev/null || echo "")"
            if [ -f "$RESTORE_PENDING_FILE" ]; then
                log "resume: unknown but a restore is in flight; not consuming state"
                flock -u 207 2> /dev/null || true
                exec 207>&-
                return "$RC_DEFER"
            fi
            if [[ "$cur" =~ ^[0-9]+$ ]] && [ "$((10#$cur))" -eq "$saved" ]; then
                if [ "$latest" != "$saved" ]; then
                    # A blank replaced the state while we were probing; its
                    # newer value must survive (and the flag stays for retry).
                    log "resume: state changed to $latest during probe; keeping it"
                    flock -u 207 2> /dev/null || true
                    exec 207>&-
                    return "$RC_DEFER"
                fi
                # Safe convergence: firmware already shows the saved value and
                # STATE_FILE is unchanged, so consume it WITHOUT any write.
                rm -f "$STATE_FILE" 2> /dev/null || true
                rm -f "$HANDOFF_RESUME_FILE" 2> /dev/null || true
                log "resume: ScreenSaver unknown but brightness already $saved; state consumed without writing"
                flock -u 207 2> /dev/null || true
                exec 207>&-
                return "$RC_DONE"
            fi
            flock -u 207 2> /dev/null || true
            exec 207>&-
            if [ "$C640_KBD_RESUME_ALLOW_UNKNOWN" = "1" ]; then
                log_warn "resume: ScreenSaver unknown and brightness $cur != $saved; C640_KBD_RESUME_ALLOW_UNKNOWN=1 -> restoring"
                rc=0
                # Explicit opt-in is the only allowed bypass of the
                # fail-closed tristate guard inside restore_state.
                if restore_state 1; then rc=0; else rc=$?; fi
                local frc=0
                _finish_resume_restore "$rc" || frc=$?
                return "$frc"
            fi
            log_warn "resume: ScreenSaver unknown (current=$cur saved=$saved); deferring restore, handoff kept"
            return "$RC_DEFER"
            ;;
    esac
    # Defensive fallback: an unhandled tristate value is never a success.
    return "$RC_DEFER"
}

handle_resume() {
    (
        if ! exec 206> "$RESUME_LOCK"; then
            log_warn "cannot open resume lock $RESUME_LOCK"
            exit 0
        fi
        if ! flock -n 206; then
            log_debug "resume: another handler already active; skipping duplicate"
            exec 206>&-
            exit 0
        fi
        local rc=0
        _handle_resume_locked || rc=$?
        flock -u 206 2> /dev/null || true
        exec 206>&-
        exit "$rc"
    )
}

# Startup recovery for a daemon restarted while the machine was suspended, or
# for a dead dbus-monitor that missed PrepareForSleep(false).  main() calls
# this in the background so startup latency is unaffected.
startup_resume_handoff() {
    if [ ! -f "$HANDOFF_RESUME_FILE" ]; then
        return 0
    fi
    log "startup: resume handoff found; adopting after thaw"
    handle_resume
}

# --- Blank / unblank guards ----------------------------------------------

guard_blank() {
    local delay
    for delay in 0.25 1.0; do
        (
            sleep "$delay"
            # Only an explicit "true" counts as active; every other value
            # (including a future tristate "unknown") means inactive.
            if [ "$(screensaver_is_active)" = "true" ]; then
                : # active: verify the light is really off
            else
                exit 0
            fi
            local cur
            cur="$(get_brightness)"
            if [[ "$cur" =~ ^[0-9]+$ ]] && [ "$cur" -ne 0 ]; then
                log_warn "blank guard +${delay}s: brightness=$cur while ScreenSaver active; forcing 0"
                local grc=0
                if set_brightness 0; then grc=0; else grc=$?; fi
                if [ "$grc" -ne 0 ]; then
                    log_warn "blank guard +${delay}s: failed to force 0 (rc=$grc)"
                fi
            fi
        ) &
    done
}

guard_unblank() {
    local saved="$1"
    local max
    max="$(get_max)"
    if ! [[ "$max" =~ ^[0-9]+$ ]] || [ "$max" -eq 0 ]; then
        max=100
    fi
    local want_pct
    want_pct=$((saved * 100 / max))
    local delay
    for delay in 0.3 0.9; do
        (
            # This runs in a subshell: it cannot write HAVE_* back to the
            # parent, but it does give this guard the freshest backend state.
            ensure_backends
            sleep "$delay"
            # This guard can write a restored brightness, so it follows the
            # same fail-closed rule as restore_state: only inactive proceeds.
            if [ "$(screensaver_tristate)" != "inactive" ]; then
                exit 0
            fi
            local ok=0
            local raw
            raw="$(get_brightness)"
            if [ "$raw" = "$saved" ]; then
                ok=1
            fi
            if [ "$HAVE_GSD_KBD" = "1" ]; then
                local gpct
                gpct="$(gsd_get_pct || echo "")"
                if [ "$gpct" != "$want_pct" ]; then
                    ok=0
                fi
            fi
            if [ "$ok" -ne 1 ]; then
                log_warn "unblank guard +${delay}s: brightness mismatch (raw=$raw, want=$saved); re-setting"
                local grc=0
                if set_brightness "$saved"; then grc=0; else grc=$?; fi
                if [ "$grc" -ne 0 ]; then
                    log_warn "unblank guard +${delay}s: re-set failed (rc=$grc)"
                fi
            fi
        ) &
    done
}

handle_blank() {
    save_state
    local rc=0
    if set_brightness 0; then rc=0; else rc=$?; fi
    if [ "$rc" -ne 0 ]; then
        log_warn "blank: failed to switch keyboard backlight off (rc=$rc)"
    fi
    guard_blank
}

handle_unblank() {
    # P1: when the sleep hook has published a resume flag, this restore belongs
    # to handle_resume(), which serialises every resume writer with RESUME_LOCK
    # and consumes the handoff exactly once.  Going straight to restore_state()
    # here races with the login1 monitor / sampler and lets a later
    # handle_resume() re-adopt a stale handoff value (double gsd write, or
    # overwriting a brightness the user changed in between).
    if [ -f "$HANDOFF_RESUME_FILE" ]; then
        log "unblank: resume flag present; routing through handle_resume"
        local rrc=0
        handle_resume || rrc=$?
        # DEFER is the normal "retry later" outcome, not a handler failure:
        # callers using `handle_unblank || log_warn ...` must not print a false
        # failure.  Other rc values still propagate.
        if [ "$rrc" -eq "$RC_DEFER" ]; then
            rrc=0
        fi
        return "$rrc"
    fi
    local saved=""
    if [ -f "$STATE_FILE" ]; then
        saved="$(cat "$STATE_FILE" 2> /dev/null || echo "")"
    fi
    local rc=0
    if restore_state; then rc=0; else rc=$?; fi
    # RC_DEFER is a normal retryable outcome (active screen, lock contention
    # or a staged restore in flight), not a failure.  Printing "restore
    # failed" here would cry wolf on every ordinary deferral.
    if [ "$rc" -eq "$RC_DEFER" ]; then
        log "unblank: restore deferred (rc=$rc); state kept for retry"
    elif [ "$rc" -ne 0 ]; then
        log_warn "unblank: restore failed (rc=$rc)"
    elif [[ "$saved" =~ ^[0-9]+$ ]] && [ "$saved" -ne 0 ]; then
        guard_unblank "$saved"
    fi
}

is_screensaver_available() {
    if command -v gdbus > /dev/null 2>&1; then
        timeout 3 gdbus introspect --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver 2> /dev/null | grep -q "ActiveChanged" && return 0
        timeout 3 gdbus introspect --session --dest org.freedesktop.ScreenSaver --object-path /org/freedesktop/ScreenSaver 2> /dev/null | grep -q "ActiveChanged" && return 0
    fi
    if command -v busctl > /dev/null 2>&1; then
        busctl --user status org.gnome.ScreenSaver 2> /dev/null | grep -q "org.gnome.ScreenSaver" && return 0
        busctl --user status org.freedesktop.ScreenSaver 2> /dev/null | grep -q "org.freedesktop.ScreenSaver" && return 0
        busctl --user get-property org.gnome.ScreenSaver /org/gnome/ScreenSaver org.gnome.ScreenSaver Active 2> /dev/null | grep -q "b " && return 0
    fi
    return 1
}

monitor_screensaver_dbus_monitor() {
    # Monitor both GNOME and freedesktop ScreenSaver (covers GNOME Wayland + KDE/Sway fallback)
    # shellcheck disable=SC2094
    dbus-monitor --session "type='signal',interface='org.gnome.ScreenSaver',member='ActiveChanged'" "type='signal',interface='org.freedesktop.ScreenSaver',member='ActiveChanged'" 2> /dev/null | while IFS= read -r line; do
        log_debug "dbus-monitor: $line"
        # Filter to ScreenSaver interfaces only - dbus-monitor already filtered, but keep guard for gdbus fallback
        if echo "$line" | grep -q "ActiveChanged"; then
            # Need to read next lines for boolean value; we handle per-line boolean
            continue
        fi
        case "$line" in
            *boolean\ true*)
                log "ScreenSaver active -> saving and turning off kbd backlight"
                handle_blank || log_warn "dbus-monitor: blank handler failed"
                ;;
            *boolean\ false*)
                log "ScreenSaver inactive -> restoring kbd backlight"
                sleep 0.5
                handle_unblank || log_warn "dbus-monitor: unblank handler failed"
                ;;
        esac
    done
}

monitor_screensaver_gdbus() {
    # Fallback via gdbus monitor: watch both destinations without --dest filter
    gdbus monitor --session 2> /dev/null | while IFS= read -r line; do
        log_debug "gdbus monitor: $line"
        if echo "$line" | grep -q "ActiveChanged"; then
            if echo "$line" | grep -q "org.gnome.ScreenSaver\|org.freedesktop.ScreenSaver"; then
                if echo "$line" | grep -q "true"; then
                    log "ScreenSaver active (gdbus) -> off"
                    handle_blank || log_warn "gdbus monitor: blank handler failed"
                elif echo "$line" | grep -q "false"; then
                    log "ScreenSaver inactive (gdbus) -> restore"
                    sleep 0.5
                    handle_unblank || log_warn "gdbus monitor: unblank handler failed"
                fi
            fi
        fi
    done
}

monitor_login1() {
    dbus-monitor --system "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" 2> /dev/null | while IFS= read -r line; do
        log_debug "login1: $line"
        case "$line" in
            *boolean\ true*)
                log "PrepareForSleep true -> saving"
                save_state
                # Drop a stale flag from any previous cycle; the hook's post
                # phase will publish a fresh one after this resume.
                rm -f "$HANDOFF_RESUME_FILE" 2> /dev/null || true
                ;;
            *boolean\ false*)
                log "PrepareForSleep false -> daemon adopts handoff and restores"
                # The hook no longer probes D-Bus or writes brightness while
                # user.slice is frozen.  It only published handoff files; the
                # thawed daemon owns the single restore path now.
                local rrc=0
                handle_resume || rrc=$?
                # rc=2 means deferred (retry via sampler/unblank), not failure.
                if [ "$rrc" -ne 0 ] && [ "$rrc" -ne "$RC_DEFER" ]; then
                    log_warn "login1: resume handler failed (rc=$rrc)"
                fi
                ;;
        esac
    done
}

idle_poll_loop() {
    if ! command -v gsettings > /dev/null 2>&1; then
        return 0
    fi
    if ! command -v gdbus > /dev/null 2>&1; then
        return 0
    fi
    if ! timeout 3 gdbus introspect --session --dest org.gnome.Mutter.IdleMonitor --object-path /org/gnome/Mutter/IdleMonitor/Core 2> /dev/null | grep -q "GetIdletime"; then
        log "Mutter IdleMonitor not available, idle polling disabled"
        return 0
    fi
    local idle_delay
    idle_delay="$(gsettings get org.gnome.desktop.session idle-delay 2> /dev/null | grep -o '[0-9][0-9]*' || echo 300)"
    if ! [[ "$idle_delay" =~ ^[0-9]+$ ]] || [ "$idle_delay" -eq 0 ]; then
        log "idle-delay 0, idle polling disabled"
        return 0
    fi
    local threshold
    threshold=$(((idle_delay + 5) * 1000))
    log "idle polling enabled: idle-delay=${idle_delay}s threshold=${threshold}ms"
    local was_idle=0
    while true; do
        local idletime
        idletime="$(timeout 3 gdbus call --session --dest org.gnome.Mutter.IdleMonitor --object-path /org/gnome/Mutter/IdleMonitor/Core --method org.gnome.Mutter.IdleMonitor.GetIdletime 2> /dev/null | grep -o '[0-9][0-9]*' | head -n1 || echo 0)"
        if ! [[ "$idletime" =~ ^[0-9]+$ ]]; then
            idletime=0
        fi
        if [ "$idletime" -ge "$threshold" ]; then
            if [ "$was_idle" -eq 0 ]; then
                log "idle threshold reached (${idletime}ms) -> off"
                handle_blank || log_warn "idle poll: blank handler failed"
                was_idle=1
            fi
        else
            if [ "$was_idle" -eq 1 ]; then
                log "user active (idletime ${idletime}ms) -> restore"
                sleep 0.5
                handle_unblank || log_warn "idle poll: unblank handler failed"
                was_idle=0
            fi
        fi
        sleep 5
    done
}

print_help() {
    echo "Usage: $0 [OPTIONS]"
    echo "  --help, -h           Show help"
    echo "  --test-blank         Simulate screen blank (save + set 0)"
    echo "  --test-unblank       Simulate screen unblank (restore)"
    echo "  --check              Check status"
    echo "  --daemon             Run daemon (default)"
    echo ""
    echo "Env:"
    echo "  C640_KBD_ENABLE_IDLEMONITOR=1  Enable Mutter IdleMonitor polling"
    echo "  C640_KBD_FORCE_LEGACY=1        Force sysfs/ectool path (no D-Bus)"
    echo "  C640_KBD_DEBUG=1               Verbose monitor/debug logging"
    echo "  C640_KBD_SYSFS_BRIGHTNESS=PATH Override sysfs brightness path"
    echo "  C640_KBD_SYSFS_MAX=PATH        Override sysfs max_brightness path"
    echo "  C640_KBD_HANDOFF_SUSPEND=PATH  Override suspend handoff file (tests)"
    echo "  C640_KBD_HANDOFF_RESUME=PATH   Override resume handoff flag (tests)"
    echo "  C640_KBD_RESUME_PROBE_MAX=N    Cap ScreenSaver polling after thaw (default 10s)"
    echo "  C640_KBD_RESUME_ALLOW_UNKNOWN=1 Opt in to restoring when ScreenSaver is unknown"
}

check_status() {
    echo "=== c640-kbd-backlight-sync status ==="
    echo "SYSFS: $SYSFS_BRIGHTNESS"
    if [ -f "$SYSFS_BRIGHTNESS" ]; then
        echo "  brightness: $(cat "$SYSFS_BRIGHTNESS" 2> /dev/null || echo "?") / $(cat "$SYSFS_MAX" 2> /dev/null || echo "?")"
    else
        echo "  NOT FOUND"
    fi
    echo "STATE_FILE: $STATE_FILE"
    if [ -f "$STATE_FILE" ]; then
        echo "  saved: $(cat "$STATE_FILE")"
    else
        echo "  (no saved state)"
    fi
    echo "Daemon running: $(pgrep -f "[c]640-kbd-backlight-sync" > /dev/null && echo yes || echo no)"
    echo "ScreenSaver available: $(is_screensaver_available && echo yes || echo no)"
    echo "IdleMonitor enabled: $C640_KBD_ENABLE_IDLEMONITOR"
    ensure_backends
    echo "gsd-power keyboard backend: $([ "$HAVE_GSD_KBD" = "1" ] && echo yes || echo no)"
    echo "UPower keyboard backend: $([ "$HAVE_UPOWER_KBD" = "1" ] && echo yes || echo no)"
    echo "UPower raw: $(upower_get_raw 2> /dev/null || echo "?")"
    echo "gsd-power pct: $(gsd_get_pct 2> /dev/null || echo "?")"
    if command -v gdbus > /dev/null 2>&1; then
        echo "gdbus: available"
    else
        echo "gdbus: not found"
    fi
    if command -v dbus-monitor > /dev/null 2>&1; then
        echo "dbus-monitor: available"
    else
        echo "dbus-monitor: not found"
    fi
}

cleanup() {
    log "cleanup: restoring if needed"
    local rc=0
    if restore_state; then rc=0; else rc=$?; fi
    if [ "$rc" -ne 0 ]; then
        log_warn "cleanup restore not completed (rc=$rc); state kept for retry"
    fi
    # kill background jobs
    jobs -p | xargs -r kill 2> /dev/null || true
    exit 0
}

main() {
    # Recover a value stranded by a crash between restore staging and finalize.
    recover_pending_state

    # Handle CLI (semantics unchanged; --test-* do not touch ScreenSaver).
    if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
        print_help
        exit 0
    fi
    if [ "${1:-}" = "--test-blank" ]; then
        save_state
        local rc=0
        if set_brightness 0; then rc=0; else rc=$?; fi
        if [ "$rc" -ne 0 ]; then
            echo "simulated blank: failed to set 0 (rc=$rc)" >&2
            exit 1
        fi
        echo "simulated blank: saved and set 0"
        exit 0
    fi
    if [ "${1:-}" = "--test-unblank" ]; then
        local rc=0
        if restore_state; then rc=0; else rc=$?; fi
        if [ "$rc" -ne 0 ]; then
            if [ "$rc" -eq "$RC_DEFER" ]; then
                echo "simulated unblank: restore deferred (rc=$rc); state kept for retry" >&2
            else
                echo "simulated unblank: restore failed (rc=$rc)" >&2
            fi
            # Keep the non-zero CLI contract even for a deferral.
            exit 1
        fi
        echo "simulated unblank: restored"
        exit 0
    fi
    if [ "${1:-}" = "--check" ]; then
        check_status
        exit 0
    fi

    # Probe gsd-power / UPower once at daemon start.
    ensure_backends

    if [ ! -f "$SYSFS_BRIGHTNESS" ] && [ "$HAVE_UPOWER_KBD" != "1" ] && ! command -v ectool > /dev/null 2>&1 && [ ! -x /usr/local/bin/ectool ]; then
        log "no backlight interface found, exiting"
        exit 0
    fi

    # Single instance per user via flock (secure per-user lock)
    umask 077
    mkdir -p "$STATE_DIR" 2> /dev/null || true
    chmod 700 "$STATE_DIR" 2> /dev/null || true
    # Open lock file securely.  Never redirect stderr here: daemon warnings
    # must reach the journal (see the unit's StandardError=journal).
    if ! exec 9> "$LOCK_FILE"; then
        log "cannot open lock file $LOCK_FILE, exiting"
        exit 1
    fi
    chmod 600 "$LOCK_FILE" 2> /dev/null || true
    if ! flock -n 9; then
        log "another instance is running, exiting"
        exit 0
    fi

    trap cleanup TERM INT EXIT HUP

    log "starting; SYSFS=$SYSFS_BRIGHTNESS STATE=$STATE_FILE IdleMonitor=$C640_KBD_ENABLE_IDLEMONITOR Legacy=$C640_KBD_FORCE_LEGACY"

    # If the daemon was restarted during suspend (or dbus-monitor died), the
    # hook's resume flag is still on disk.  Pick it up in the background so a
    # missed PrepareForSleep(false) still converges (Phase 4b).
    startup_resume_handoff &

    # Discard any last-user value persisted by a previous daemon run.
    seed_last_user_from_current

    # Always-on sampler for the last user-visible brightness (0 = explicit off).
    brightness_sampler_loop &

    # Start optional idle polling in background
    if [ "$C640_KBD_ENABLE_IDLEMONITOR" = "1" ]; then
        idle_poll_loop &
    fi

    # Start login1 monitor in background if dbus-monitor available (with retry)
    if command -v dbus-monitor > /dev/null 2>&1; then
        (while true; do
            monitor_login1 || log "login1 monitor exited $?, retry in 2s"
            sleep 2
        done) &
    fi

    # Main screensaver monitor (foreground) with retry to avoid Restart storm
    # dbus-monitor may exit if session bus disappears (e.g. gnome-shell restart)
    if command -v dbus-monitor > /dev/null 2>&1; then
        while true; do
            monitor_screensaver_dbus_monitor || log "dbus-monitor exited $?, retry in 2s"
            sleep 2
        done &
        wait || true
    else
        if command -v gdbus > /dev/null 2>&1; then
            log "dbus-monitor not found, falling back to gdbus"
            while true; do
                monitor_screensaver_gdbus || log "gdbus monitor exited $?, retry in 2s"
                sleep 2
            done &
            wait || true
        else
            log "no dbus monitor tool found, entering poll loop"
            prev=""
            while true; do
                active=""
                if command -v gdbus > /dev/null 2>&1; then
                    active="$(timeout 3 gdbus call --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver --method org.gnome.ScreenSaver.GetActive 2> /dev/null || echo "")"
                    if ! grep -q "true" <<< "$active"; then
                        active="$(timeout 3 gdbus call --session --dest org.freedesktop.ScreenSaver --object-path /org/freedesktop/ScreenSaver --method org.freedesktop.ScreenSaver.GetActive 2> /dev/null || echo "")"
                    fi
                    if grep -q "true" <<< "$active"; then
                        active="true"
                    else
                        active="false"
                    fi
                elif command -v busctl > /dev/null 2>&1; then
                    active="$(busctl --user get-property org.gnome.ScreenSaver /org/gnome/ScreenSaver org.gnome.ScreenSaver Active 2> /dev/null || echo "")"
                    if ! grep -q "true" <<< "$active"; then
                        active="$(busctl --user get-property org.freedesktop.ScreenSaver /org/freedesktop/ScreenSaver org.freedesktop.ScreenSaver Active 2> /dev/null || echo "")"
                    fi
                    if grep -q "true" <<< "$active"; then
                        active="true"
                    else
                        active="false"
                    fi
                else
                    sleep 5
                    continue
                fi
                if [ "$active" != "$prev" ]; then
                    if [ "$active" = "true" ]; then
                        handle_blank || log_warn "poll loop: blank handler failed"
                    else
                        sleep 0.5
                        handle_unblank || log_warn "poll loop: unblank handler failed"
                    fi
                    prev="$active"
                fi
                sleep 2
            done
        fi
    fi
}

# Safe to source for stub/unit testing: only run when executed directly.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
