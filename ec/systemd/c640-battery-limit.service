[Unit]
Description=HP Pro c640 Battery Charge Protection Daemon (90% Limit)
After=sysinit.target

[Service]
Type=simple
ExecStart=/usr/local/bin/c640-ec-control battery-daemon 90
ExecStop=/usr/local/bin/c640-ec-control battery-full
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
