# Copy this file to .env and fill in your own values.
# Never commit .env: it contains live API credentials.
# Requires the GitHub Actions secrets CPA_BASE_URL / CPA_API_KEY / OPENCODE2API_BASE_URL1 / OPENCODE2API_BASE_URL / OPENCODE2API_BASE_URL2 / OPENCODE2API_API_KEY.
CPA_BASE_URL="https://your-cpa-endpoint.example.com/v1/"
CPA_API_KEY="sk-your-cpa-api-key"
OPENCODE2API_BASE_URL1="https://opencode2api-1.example.com/v1/"
OPENCODE2API_BASE_URL="https://opencode2api.example.com/v1/"
OPENCODE2API_BASE_URL2="https://opencode2api-2.example.com/v1/"
OPENCODE2API_API_KEY="sk-your-opencode2api-api-key"