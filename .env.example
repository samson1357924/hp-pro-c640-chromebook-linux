# Copy this file to .env and fill in your own values.
# Never commit .env: it contains live API credentials.
# Requires the GitHub Actions secrets CPA_BASE_URL / CPA_API_KEY / OPENCODE_API_KEY.
CPA_BASE_URL="https://your-cpa-endpoint.example.com/v1/"
CPA_API_KEY="sk-your-cpa-api-key"
OPENCODE_API_KEY="sk-your-opencode-api-key"